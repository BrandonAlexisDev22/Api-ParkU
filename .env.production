# =============================================
# PARKU API - PRODUCCIÓN
# =============================================

# ========== SERVIDOR ==========
PORT=3000
NODE_ENV=production

# ========== BASE DE DATOS ==========
DB_HOST=tu-host-postgres.com
DB_PORT=5432
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=parku_prod
DB_POOL_MAX=20
DB_SSL=true

# ========== JWT (AUTENTICACIÓN) ==========
JWT_SECRET=clave_super_segura_produccion
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ========== BCRYPT ==========
BCRYPT_ROUNDS=12

# ========== CORS ==========
CORS_ORIGIN=https://tu-dominio.com,https://www.tu-dominio.com

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50