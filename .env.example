# Copiar como .env y completar con valores reales. Nunca commitear .env con secretos.

# Base de datos (Neon Postgres) -- o DATABASE_URL, o las variables separadas.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_MAX=20
DB_SSL=require
DB_DIALECT=postgres

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Correo (SMTP) -- verificación de cuenta y recuperación de contraseña.
#
# Opción A (recomendada): MAIL_SERVICE con el nombre de un proveedor conocido. El
# host/puerto/TLS los resuelve nodemailer solo. Nombres válidos: Gmail, GmailWorkspace,
# Outlook365, Hotmail, Yahoo, Zoho, iCloud, Brevo (SendinBlue), SendGrid, Mailgun,
# Mailjet, Postmark, Resend, Mailtrap, SES (y SES-<región>), MailerSend, SMTP2GO,
# Sparkpost, ElasticEmail, Yandex, GMX, QQ, Naver, Proton, FastMail, Ethereal...
# Lista completa: npm run mail:test -- --servicios
#
# Opción B: dejar MAIL_SERVICE vacío y poner SMTP_HOST a mano (SMTP corporativo, cPanel,
# un relay propio). MAIL_SERVICE, si está, tiene prioridad sobre SMTP_HOST.
#
# Sin MAIL_SERVICE ni SMTP_HOST el envío queda en no-op (se registra en el log) sin
# romper el registro/recuperación -- ver src/utils/mailer.util.js.
#
# Contraseña: casi ningún proveedor acepta la contraseña normal de la cuenta.
#   Gmail    -> App Password de 16 caracteres (requiere verificación en 2 pasos activa)
#   Outlook  -> App Password de la cuenta Microsoft
#   Brevo/SendGrid/Resend/Mailtrap -> la API key SMTP que genera el panel
#
# ⚠️  Este archivo ES UNA PLANTILLA RASTREADA POR GIT: se sube al repositorio.
#     Los valores reales (usuario, contraseña) van SOLO en .env, que sí está en
#     .gitignore. Aquí las claves se dejan vacías siempre.
MAIL_SERVICE=
# SMTP_HOST es un NOMBRE DE SERVIDOR (smtp.miempresa.com), no un correo. Déjalo vacío
# si usas MAIL_SERVICE.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Remitente. Debe ser una dirección que el proveedor autorice a enviar (en Gmail, la
# misma cuenta de SMTP_USER). Admite el formato "Nombre <correo@dominio>".
MAIL_FROM=
FRONTEND_URL=https://park-u.vercel.app

# Expiración de tokens (minutos). Opcionales, tienen default en el código.
RECUPERACION_PASSWORD_TTL_MINUTOS=60
VERIFICACION_CORREO_TTL_MINUTOS=1440
# Expiración del código de 6 dígitos, más corto que el enlace porque es más fácil de adivinar.
VERIFICACION_CODIGO_TTL_MINUTOS=60
