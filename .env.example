# Copiar como .env y completar con valores reales. Nunca commitear .env con secretos.

# Base de datos (Neon Postgres) -- o DATABASE_URL, o las variables separadas.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_MAX=20
DB_SSL=require
DB_DIALECT=postgres

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Correo (SMTP) -- verificación de cuenta y recuperación de contraseña.
# Sin SMTP_HOST configurado, el envío de correo queda en no-op (se registra en el log)
# sin romper el registro/recuperación -- ver src/utils/mailer.util.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@parku.local
FRONTEND_URL=https://park-u.vercel.app

# Expiración de tokens (minutos). Opcionales, tienen default en el código.
RECUPERACION_PASSWORD_TTL_MINUTOS=60
VERIFICACION_CORREO_TTL_MINUTOS=1440
