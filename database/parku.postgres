--
-- Name: reserva; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.reserva (
    id integer NOT NULL,
    tipo_reserva public.tipo_reserva_enum NOT NULL,
    celda_id integer NOT NULL,
    usuario_registra_id integer NOT NULL,
    conductor_id integer,
    vehiculo_id integer,
    motivo character varying(255),
    fecha_hora_inicio timestamp without time zone NOT NULL,
    fecha_hora_fin timestamp without time zone NOT NULL,
    estado public.estado_reserva_enum DEFAULT 'PENDIENTE'::public.estado_reserva_enum NOT NULL,
    usuario_gestiona_id integer,
    fecha_creacion timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    motivo_rechazo character varying(500),
    CONSTRAINT chk_reserva_gestion CHECK (((estado = 'PENDIENTE'::public.estado_reserva_enum) OR (usuario_gestiona_id IS NOT NULL))),
    CONSTRAINT ck_reserva_fechas CHECK ((fecha_hora_fin > fecha_hora_inicio))
);


