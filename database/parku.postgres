--
-- Name: v_parqueadero_front _RETURN; Type: RULE; Schema: public; Owner: -
--

CREATE OR REPLACE VIEW public.v_parqueadero_front AS
 SELECT p.id,
    p.nombre,
    p.ubicacion AS direccion,
    p.descripcion,
    p.tipo,
    p.acceso,
    p.zona AS bloque,
    p.piso,
    p.capacidad_maxima AS capacidad,
    p.hora_apertura AS hora_inicio,
    p.hora_cierre AS hora_fin,
    p.estado,
    count(c.id) AS celdas_totales,
    count(*) FILTER (WHERE (c.tipo = 'CARRO'::public.tipo_vehiculo_enum)) AS celdas_carros,
    count(*) FILTER (WHERE (c.tipo = 'MOTO'::public.tipo_vehiculo_enum)) AS celdas_motos,
    count(*) FILTER (WHERE (c.tipo = 'BICICLETA'::public.tipo_vehiculo_enum)) AS celdas_bicicletas,
    count(*) FILTER (WHERE (c.usabilidad = 'MOVILIDAD_REDUCIDA'::public.usabilidad_enum)) AS celdas_movilidad_reducida,
    count(*) FILTER (WHERE (c.estado = 'DISPONIBLE'::public.estado_celda_enum)) AS celdas_disponibles,
    count(*) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)) AS celdas_ocupadas
   FROM (public.parqueadero p
     LEFT JOIN public.celda c ON ((c.parqueadero_id = p.id)))
  GROUP BY p.id;


--
-- Name: v_rol_permisos_front _RETURN; Type: RULE; Schema: public; Owner: -
--

CREATE OR REPLACE VIEW public.v_rol_permisos_front AS
 SELECT r.id,
    r.nombre,
    r.descripcion,
    r.estado,
    jsonb_build_object('dashboard', bool_or(((p.nombre)::text = 'reportes.consultar'::text)), 'roles', bool_or(((p.nombre)::text = 'configuracion.gestionar'::text)), 'usuarios', bool_or(((p.nombre)::text = 'usuarios.gestionar'::text)), 'conductores', bool_or(((p.nombre)::text = ANY ((ARRAY['ingreso.gestionar'::character varying, 'ingreso.consultar'::character varying])::text[]))), 'vehiculos', bool_or(((p.nombre)::text = ANY ((ARRAY['ingreso.gestionar'::character varying, 'ingreso.consultar'::character varying])::text[]))), 'parqueaderos', bool_or(((p.nombre)::text = 'parqueaderos.gestionar'::text)), 'celdas', bool_or(((p.nombre)::text = 'parqueaderos.gestionar'::text)), 'asignaciones', bool_or(((p.nombre)::text = 'ingreso.gestionar'::text)), 'entradaSalida', bool_or(((p.nombre)::text = ANY ((ARRAY['ingreso.gestionar'::character varying, 'salida.gestionar'::character varying])::text[]))), 'reservas', bool_or(((p.nombre)::text = 'reservas.gestionar'::text)), 'incidentes', bool_or(((p.nombre)::text = 'novedades.gestionar'::text)), 'reconocimientoPlacas', bool_or(((p.nombre)::text = 'novedades.gestionar'::text))) AS permisos
   FROM ((public.rol r
     LEFT JOIN public.rol_permiso rp ON (((rp.rol_id = r.id) AND (rp.estado = true))))
     LEFT JOIN public.permiso p ON ((p.id = rp.permiso_id)))
  GROUP BY r.id;


