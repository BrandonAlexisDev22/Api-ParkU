    descripcion_ingreso character varying(255),
    descripcion_salida character varying(255),
    estado public.estado_acceso_enum DEFAULT 'DENTRO'::public.estado_acceso_enum NOT NULL,
    CONSTRAINT ck_registro_acceso_fechas CHECK (((fecha_hora_salida IS NULL) OR (fecha_hora_salida >= fecha_hora_ingreso)))
);


