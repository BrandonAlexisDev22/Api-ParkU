CREATE SCHEMA "public";
CREATE SCHEMA "neon_auth";
CREATE TYPE "celda_tipo_enum" AS ENUM('CARRO', 'MOTO', 'MOVILIDAD_REDUCIDA', 'BICICLETA');
CREATE TYPE "celda_usabilidad_enum" AS ENUM('GENERAL', 'EJECUTIVO', 'MOVILIDAD_REDUCIDA');
CREATE TYPE "celda_estado_enum" AS ENUM('DISPONIBLE', 'OCUPADO', 'MANTENIMIENTO', 'INACTIVA');
CREATE TYPE "reserva_estado_enum" AS ENUM('ACEPTADA', 'TERMINADA', 'PENDIENTE', 'CANCELADA');
CREATE TYPE "ingreso_salida_tipo_enum" AS ENUM('INGRESO', 'SALIDA');
CREATE TYPE "novedad_tipo_enum" AS ENUM('DAÑO', 'ACCIDENTE', 'MAL_ESTACIONAMIENTO', 'QUEJA', 'OTRO');
CREATE TYPE "novedad_prioridad_enum" AS ENUM('BAJA', 'MEDIA', 'ALTA', 'CRITICA');
CREATE TYPE "novedad_estado_enum" AS ENUM('RESUELTA', 'PENDIENTE', 'CANCELADA');
CREATE TABLE "celda" (
	"id" serial PRIMARY KEY,
	"parqueadero_id" integer NOT NULL,
	"tipo" celda_tipo_enum NOT NULL,
	"usabilidad" celda_usabilidad_enum DEFAULT 'GENERAL' NOT NULL,
	"estado_celda" celda_estado_enum DEFAULT 'DISPONIBLE' NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "centro_formacion" (
	"id" serial PRIMARY KEY,
	"regional_formacion_id" integer NOT NULL,
	"nombre" varchar(255) NOT NULL,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL,
	CONSTRAINT "centro_formacion_regional_formacion_id_nombre_key" UNIQUE("regional_formacion_id","nombre")
);
CREATE TABLE "conductor" (
	"id" serial PRIMARY KEY,
	"usuario_id" integer,
	"tipo_documento" varchar(20) DEFAULT 'CC' NOT NULL,
	"numero_documento" varchar(20) NOT NULL,
	"nombre_apellidos" varchar(200) NOT NULL,
	"correo" citext CONSTRAINT "conductor_correo_key" UNIQUE,
	"direccion" varchar(255) NOT NULL,
	"numero_telefonico" varchar(20),
	"tipo_usuario_id" integer NOT NULL,
	"regional_formacion_id" integer NOT NULL,
	"centro_formacion_id" integer NOT NULL,
	"programa_formacion_id" integer NOT NULL,
	"vigencia" timestamp with time zone NOT NULL,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL,
	CONSTRAINT "conductor_tipo_documento_numero_documento_key" UNIQUE("tipo_documento","numero_documento")
);
CREATE TABLE "marca_vehiculo" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(100) NOT NULL CONSTRAINT "marca_vehiculo_nombre_key" UNIQUE,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "parqueadero" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(100) NOT NULL,
	"ubicacion" varchar(255),
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "permiso" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(100) NOT NULL CONSTRAINT "permiso_nombre_key" UNIQUE,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "playing_with_neon" (
	"id" serial PRIMARY KEY,
	"name" text NOT NULL,
	"value" real
);
CREATE TABLE "programa_formacion" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(255) NOT NULL CONSTRAINT "programa_formacion_nombre_key" UNIQUE,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "regional_formacion" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(255) NOT NULL CONSTRAINT "regional_formacion_nombre_key" UNIQUE,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "rol" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(50) NOT NULL CONSTRAINT "rol_nombre_key" UNIQUE,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "rol_permiso" (
	"id" serial PRIMARY KEY,
	"rol_id" integer NOT NULL,
	"permiso_id" integer NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL,
	CONSTRAINT "rol_permiso_rol_id_permiso_id_key" UNIQUE("rol_id","permiso_id")
);
CREATE TABLE "servicio_vehiculo" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(100) NOT NULL CONSTRAINT "servicio_vehiculo_nombre_key" UNIQUE,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "tipo_usuario" (
	"id" serial PRIMARY KEY,
	"tipo_usuario" varchar(100) NOT NULL CONSTRAINT "tipo_usuario_tipo_usuario_key" UNIQUE,
	"descripcion" varchar(255),
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "tipo_vehiculo" (
	"id" serial PRIMARY KEY,
	"nombre" varchar(100) NOT NULL CONSTRAINT "tipo_vehiculo_nombre_key" UNIQUE,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
);
CREATE TABLE "usuario" (
	"id" serial PRIMARY KEY,
	"correo" citext NOT NULL CONSTRAINT "usuario_correo_key" UNIQUE,
	"contrasena" varchar(255) NOT NULL,
	"rol_id" integer,
	"estado" boolean DEFAULT true NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL,
	"nombre" varchar(20),
	"refresh_token" text
);
CREATE TABLE "neon_auth"."account" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"accountId" text NOT NULL,
	"providerId" text NOT NULL,
	"userId" uuid NOT NULL,
	"accessToken" text,
	"refreshToken" text,
	"idToken" text,
	"accessTokenExpiresAt" timestamp with time zone,
	"refreshTokenExpiresAt" timestamp with time zone,
	"scope" text,
	"password" text,
	"createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"updatedAt" timestamp with time zone NOT NULL
);
CREATE TABLE "neon_auth"."invitation" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"organizationId" uuid NOT NULL,
	"email" text NOT NULL,
	"role" text,
	"status" text NOT NULL,
	"expiresAt" timestamp with time zone NOT NULL,
	"createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"inviterId" uuid NOT NULL
);
CREATE TABLE "neon_auth"."jwks" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"publicKey" text NOT NULL,
	"privateKey" text NOT NULL,
	"createdAt" timestamp with time zone NOT NULL,
	"expiresAt" timestamp with time zone
);
CREATE TABLE "neon_auth"."member" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"organizationId" uuid NOT NULL,
	"userId" uuid NOT NULL,
	"role" text NOT NULL,
	"createdAt" timestamp with time zone NOT NULL
);
CREATE TABLE "neon_auth"."organization" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"name" text NOT NULL,
	"slug" text NOT NULL CONSTRAINT "organization_slug_key" UNIQUE,
	"logo" text,
	"createdAt" timestamp with time zone NOT NULL,
	"metadata" text
);
CREATE TABLE "neon_auth"."project_config" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"name" text NOT NULL,
	"endpoint_id" text NOT NULL CONSTRAINT "project_config_endpoint_id_key" UNIQUE,
	"created_at" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"updated_at" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"trusted_origins" jsonb NOT NULL,
	"social_providers" jsonb NOT NULL,
	"email_provider" jsonb,
	"email_and_password" jsonb,
	"allow_localhost" boolean NOT NULL,
	"plugin_configs" jsonb,
	"webhook_config" jsonb
);
CREATE TABLE "neon_auth"."session" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"expiresAt" timestamp with time zone NOT NULL,
	"token" text NOT NULL CONSTRAINT "session_token_key" UNIQUE,
	"createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"updatedAt" timestamp with time zone NOT NULL,
	"ipAddress" text,
	"userAgent" text,
	"userId" uuid NOT NULL,
	"impersonatedBy" text,
	"activeOrganizationId" text
);
CREATE TABLE "neon_auth"."user" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"name" text NOT NULL,
	"email" text NOT NULL CONSTRAINT "user_email_key" UNIQUE,
	"emailVerified" boolean NOT NULL,
	"image" text,
	"createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"role" text,
	"banned" boolean,
	"banReason" text,
	"banExpires" timestamp with time zone
);
CREATE TABLE "neon_auth"."verification" (
	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
	"identifier" text NOT NULL,
	"value" text NOT NULL,
	"expiresAt" timestamp with time zone NOT NULL,
	"createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);
CREATE UNIQUE INDEX "celda_pkey" ON "celda" ("id");
CREATE UNIQUE INDEX "centro_formacion_pkey" ON "centro_formacion" ("id");
CREATE UNIQUE INDEX "centro_formacion_regional_formacion_id_nombre_key" ON "centro_formacion" ("regional_formacion_id","nombre");
CREATE UNIQUE INDEX "conductor_correo_key" ON "conductor" ("correo");
CREATE UNIQUE INDEX "conductor_pkey" ON "conductor" ("id");
CREATE UNIQUE INDEX "conductor_tipo_documento_numero_documento_key" ON "conductor" ("tipo_documento","numero_documento");
CREATE UNIQUE INDEX "marca_vehiculo_nombre_key" ON "marca_vehiculo" ("nombre");
CREATE UNIQUE INDEX "marca_vehiculo_pkey" ON "marca_vehiculo" ("id");
CREATE UNIQUE INDEX "parqueadero_pkey" ON "parqueadero" ("id");
CREATE UNIQUE INDEX "permiso_nombre_key" ON "permiso" ("nombre");
CREATE UNIQUE INDEX "permiso_pkey" ON "permiso" ("id");
CREATE UNIQUE INDEX "playing_with_neon_pkey" ON "playing_with_neon" ("id");
CREATE UNIQUE INDEX "programa_formacion_nombre_key" ON "programa_formacion" ("nombre");
CREATE UNIQUE INDEX "programa_formacion_pkey" ON "programa_formacion" ("id");
CREATE UNIQUE INDEX "regional_formacion_nombre_key" ON "regional_formacion" ("nombre");
CREATE UNIQUE INDEX "regional_formacion_pkey" ON "regional_formacion" ("id");
CREATE UNIQUE INDEX "rol_nombre_key" ON "rol" ("nombre");
CREATE UNIQUE INDEX "rol_pkey" ON "rol" ("id");
CREATE UNIQUE INDEX "rol_permiso_pkey" ON "rol_permiso" ("id");
CREATE UNIQUE INDEX "rol_permiso_rol_id_permiso_id_key" ON "rol_permiso" ("rol_id","permiso_id");
CREATE UNIQUE INDEX "servicio_vehiculo_nombre_key" ON "servicio_vehiculo" ("nombre");
CREATE UNIQUE INDEX "servicio_vehiculo_pkey" ON "servicio_vehiculo" ("id");
CREATE UNIQUE INDEX "tipo_usuario_pkey" ON "tipo_usuario" ("id");
CREATE UNIQUE INDEX "tipo_usuario_tipo_usuario_key" ON "tipo_usuario" ("tipo_usuario");
CREATE UNIQUE INDEX "tipo_vehiculo_nombre_key" ON "tipo_vehiculo" ("nombre");
CREATE UNIQUE INDEX "tipo_vehiculo_pkey" ON "tipo_vehiculo" ("id");
CREATE UNIQUE INDEX "usuario_correo_key" ON "usuario" ("correo");
CREATE UNIQUE INDEX "usuario_pkey" ON "usuario" ("id");
CREATE UNIQUE INDEX "account_pkey" ON "neon_auth"."account" ("id");
CREATE INDEX "account_userId_idx" ON "neon_auth"."account" ("userId");
CREATE INDEX "invitation_email_idx" ON "neon_auth"."invitation" ("email");
CREATE INDEX "invitation_organizationId_idx" ON "neon_auth"."invitation" ("organizationId");
CREATE UNIQUE INDEX "invitation_pkey" ON "neon_auth"."invitation" ("id");
CREATE UNIQUE INDEX "jwks_pkey" ON "neon_auth"."jwks" ("id");
CREATE INDEX "member_organizationId_idx" ON "neon_auth"."member" ("organizationId");
CREATE UNIQUE INDEX "member_pkey" ON "neon_auth"."member" ("id");
CREATE INDEX "member_userId_idx" ON "neon_auth"."member" ("userId");
CREATE UNIQUE INDEX "organization_pkey" ON "neon_auth"."organization" ("id");
CREATE UNIQUE INDEX "organization_slug_key" ON "neon_auth"."organization" ("slug");
CREATE UNIQUE INDEX "organization_slug_uidx" ON "neon_auth"."organization" ("slug");
CREATE UNIQUE INDEX "project_config_endpoint_id_key" ON "neon_auth"."project_config" ("endpoint_id");
CREATE UNIQUE INDEX "project_config_pkey" ON "neon_auth"."project_config" ("id");
CREATE UNIQUE INDEX "session_pkey" ON "neon_auth"."session" ("id");
CREATE UNIQUE INDEX "session_token_key" ON "neon_auth"."session" ("token");
CREATE INDEX "session_userId_idx" ON "neon_auth"."session" ("userId");
CREATE UNIQUE INDEX "user_email_key" ON "neon_auth"."user" ("email");
CREATE UNIQUE INDEX "user_pkey" ON "neon_auth"."user" ("id");
CREATE INDEX "verification_identifier_idx" ON "neon_auth"."verification" ("identifier");
CREATE UNIQUE INDEX "verification_pkey" ON "neon_auth"."verification" ("id");
ALTER TABLE "celda" ADD CONSTRAINT "celda_parqueadero_id_fkey" FOREIGN KEY ("parqueadero_id") REFERENCES "parqueadero"("id") ON DELETE RESTRICT;
ALTER TABLE "centro_formacion" ADD CONSTRAINT "centro_formacion_regional_formacion_id_fkey" FOREIGN KEY ("regional_formacion_id") REFERENCES "regional_formacion"("id") ON DELETE RESTRICT;
ALTER TABLE "conductor" ADD CONSTRAINT "conductor_centro_formacion_id_fkey" FOREIGN KEY ("centro_formacion_id") REFERENCES "centro_formacion"("id") ON DELETE RESTRICT;
ALTER TABLE "conductor" ADD CONSTRAINT "conductor_programa_formacion_id_fkey" FOREIGN KEY ("programa_formacion_id") REFERENCES "programa_formacion"("id") ON DELETE RESTRICT;
ALTER TABLE "conductor" ADD CONSTRAINT "conductor_regional_formacion_id_fkey" FOREIGN KEY ("regional_formacion_id") REFERENCES "regional_formacion"("id") ON DELETE RESTRICT;
ALTER TABLE "conductor" ADD CONSTRAINT "conductor_tipo_usuario_id_fkey" FOREIGN KEY ("tipo_usuario_id") REFERENCES "tipo_usuario"("id") ON DELETE RESTRICT;
ALTER TABLE "conductor" ADD CONSTRAINT "conductor_usuario_id_fkey" FOREIGN KEY ("usuario_id") REFERENCES "usuario"("id") ON DELETE SET NULL;
ALTER TABLE "rol_permiso" ADD CONSTRAINT "rol_permiso_permiso_id_fkey" FOREIGN KEY ("permiso_id") REFERENCES "permiso"("id") ON DELETE CASCADE;
ALTER TABLE "rol_permiso" ADD CONSTRAINT "rol_permiso_rol_id_fkey" FOREIGN KEY ("rol_id") REFERENCES "rol"("id") ON DELETE CASCADE;
ALTER TABLE "usuario" ADD CONSTRAINT "usuario_rol_id_fkey" FOREIGN KEY ("rol_id") REFERENCES "rol"("id") ON DELETE SET NULL;
ALTER TABLE "neon_auth"."account" ADD CONSTRAINT "account_userId_fkey" FOREIGN KEY ("userId") REFERENCES "neon_auth"."user"("id") ON DELETE CASCADE;
ALTER TABLE "neon_auth"."invitation" ADD CONSTRAINT "invitation_inviterId_fkey" FOREIGN KEY ("inviterId") REFERENCES "neon_auth"."user"("id") ON DELETE CASCADE;
ALTER TABLE "neon_auth"."invitation" ADD CONSTRAINT "invitation_organizationId_fkey" FOREIGN KEY ("organizationId") REFERENCES "neon_auth"."organization"("id") ON DELETE CASCADE;
ALTER TABLE "neon_auth"."member" ADD CONSTRAINT "member_organizationId_fkey" FOREIGN KEY ("organizationId") REFERENCES "neon_auth"."organization"("id") ON DELETE CASCADE;
ALTER TABLE "neon_auth"."member" ADD CONSTRAINT "member_userId_fkey" FOREIGN KEY ("userId") REFERENCES "neon_auth"."user"("id") ON DELETE CASCADE;
ALTER TABLE "neon_auth"."session" ADD CONSTRAINT "session_userId_fkey" FOREIGN KEY ("userId") REFERENCES "neon_auth"."user"("id") ON DELETE CASCADE;