    SEQUENCE NAME public.celda_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: conductor; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.conductor (
    id integer NOT NULL,
    usuario_id integer,
    tipo_documento public.tipo_documento_enum NOT NULL,
    numero_documento character varying(20) NOT NULL,
    nombre_apellidos character varying(200) NOT NULL,
    correo character varying(255),
    direccion character varying(255),
    numero_telefonico character varying(20),
    tipo_usuario_id integer NOT NULL,
    regional_formacion character varying(255),
    centro_formacion character varying(255),
    programa_formacion character varying(255),
    vigencia date,
    movilidad_reducida boolean DEFAULT false NOT NULL,
    estado boolean DEFAULT true NOT NULL,
    fecha_creacion timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    tipo_discapacidad character varying(150),
    CONSTRAINT chk_conductor_discapacidad CHECK (((movilidad_reducida = true) OR (tipo_discapacidad IS NULL)))
);


--
-- Name: TABLE conductor; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.conductor IS 'Proceso 04.1 — Gestión de conductores';


--
-- Name: COLUMN conductor.usuario_id; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.conductor.usuario_id IS 'E-01 — EL ERROR MÁS GRAVE. Sin esta FK no funciona ninguna HU del rol conductor. NULL = registrado por vigilancia, sin cuenta';


--
-- Name: COLUMN conductor.numero_documento; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.conductor.numero_documento IS 'E-32: antes era INTEGER; perdía ceros y no admitía CE ni pasaporte';


--
-- Name: COLUMN conductor.correo; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.conductor.correo IS 'Correo de contacto de la persona. Puede existir sin cuenta (visitantes). Si conductor.usuario_id tiene valor, la credencial de acceso es usuario.correo.';


--
-- Name: COLUMN conductor.regional_formacion; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.conductor.regional_formacion IS 'Dato proveniente de SOFIA Plus';


--
-- Name: COLUMN conductor.movilidad_reducida; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.conductor.movilidad_reducida IS 'Indica que la persona tiene una condicion que la habilita para usar celdas de caracter preferencial. La base valida este campo al reservar y al ocupar una celda de usabilidad MOVILIDAD_REDUCIDA.';


--
-- Name: COLUMN conductor.tipo_discapacidad; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.conductor.tipo_discapacidad IS 'Detalle de la condicion. Solo aplica cuando movilidad_reducida = TRUE.';


