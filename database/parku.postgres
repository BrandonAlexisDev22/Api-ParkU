--
-- Name: v_autorizaciones_activas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_autorizaciones_activas AS
 SELECT a.id AS autorizacion_id,
    a.usuario_id,
    u.nombre AS usuario,
    a.conductor_id,
    c.nombre_apellidos AS conductor,
    a.parqueadero_id,
    p.nombre AS parqueadero,
    a.dia_semana,
    a.hora_inicio,
    a.hora_fin,
    a.fecha_inicio,
    a.fecha_fin,
    a.motivo,
    a.estado
   FROM (((public.autorizacion_acceso a
     LEFT JOIN public.usuario u ON ((u.id = a.usuario_id)))
     LEFT JOIN public.conductor c ON ((c.id = a.conductor_id)))
     LEFT JOIN public.parqueadero p ON ((p.id = a.parqueadero_id)))
  WHERE ((a.estado = true) AND ((a.fecha_inicio IS NULL) OR (a.fecha_inicio <= CURRENT_DATE)) AND ((a.fecha_fin IS NULL) OR (a.fecha_fin >= CURRENT_DATE)));


--
-- Name: v_celda_front; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_celda_front AS
 SELECT c.id,
    c.parqueadero_id,
    p.nombre AS parqueadero,
    c.numero,
    c.tipo,
    c.usabilidad,
    (c.usabilidad = 'MOVILIDAD_REDUCIDA'::public.usabilidad_enum) AS es_preferencial,
    c.estado,
    (c.estado = 'OCUPADA'::public.estado_celda_enum) AS ocupada,
    c.observaciones
   FROM (public.celda c
     JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)));


--
-- Name: v_celdas_disponibles; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_celdas_disponibles AS
 SELECT c.id AS celda_id,
    c.numero AS numero_celda,
    c.tipo AS tipo_celda,
    c.usabilidad,
    c.estado AS estado_celda,
    p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    p.ubicacion
   FROM (public.celda c
     JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)))
  WHERE ((c.estado = 'DISPONIBLE'::public.estado_celda_enum) AND (p.estado = true));


--
-- Name: vehiculo; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.vehiculo (
    id integer NOT NULL,
    placa character varying(10),
    tipo public.tipo_vehiculo_enum NOT NULL,
    tarjeta_propiedad character varying(20),
    marca character varying(100),
    linea character varying(100),
    modelo integer,
    cilindraje integer,
    color character varying(50),
    servicio character varying(50),
    carroceria character varying(100),
    combustible character varying(50),
    capacidad integer,
    numero_motor character varying(100),
    numero_chasis character varying(100),
    observaciones character varying(255),
    vehiculo_sena boolean DEFAULT false NOT NULL,
    estado boolean DEFAULT true NOT NULL,
    fecha_creacion timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT ck_vehiculo_placa_formato CHECK (((placa IS NULL) OR ((placa)::text = upper(regexp_replace(TRIM(BOTH FROM placa), '[^A-Za-z0-9]'::text, ''::text, 'g'::text))))),
    CONSTRAINT ck_vehiculo_placa_por_tipo CHECK (((tipo = 'BICICLETA'::public.tipo_vehiculo_enum) OR (placa IS NOT NULL)))
);


--
-- Name: TABLE vehiculo; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.vehiculo IS 'Proceso 04.2 — Gestión de vehículos';


--
-- Name: COLUMN vehiculo.placa; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.vehiculo.placa IS 'E-34 UNIQUE (HU 07.2.1.1) · E-36 nullable: las bicicletas no tienen placa';


--
-- Name: COLUMN vehiculo.tarjeta_propiedad; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.vehiculo.tarjeta_propiedad IS 'E-29 ortografía (era tarjeta_porpiedad) · E-33 tipo';


--
-- Name: COLUMN vehiculo.modelo; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.vehiculo.modelo IS 'E-13: año del vehículo. Antes era VARCHAR y se confundía con la línea';


--
-- Name: COLUMN vehiculo.carroceria; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.vehiculo.carroceria IS 'E-30: antes decía "carroseria"';


--
-- Name: v_celdas_estado_actual; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_celdas_estado_actual AS
 SELECT c.id AS celda_id,
    c.numero,
    c.estado,
    c.tipo,
    c.usabilidad,
    c.parqueadero_id,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    oc.vehiculo_id,
    v.placa,
    v.marca,
    v.modelo,
    v.color,
    co.id AS conductor_id,
    co.nombre_apellidos AS conductor,
    r.id AS reserva_id,
    r.fecha_hora_inicio AS reserva_inicio,
    r.fecha_hora_fin AS reserva_fin
   FROM ((((((public.celda c
     JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)))
     LEFT JOIN public.ocupacion_celda oc ON (((oc.celda_id = c.id) AND (oc.estado = 'ACTIVA'::public.estado_ocupacion_enum))))
     LEFT JOIN public.vehiculo v ON ((v.id = oc.vehiculo_id)))
     LEFT JOIN public.registro_acceso ra ON ((ra.id = oc.registro_acceso_id)))
     LEFT JOIN public.conductor co ON ((co.id = COALESCE(ra.conductor_id, ( SELECT dp.conductor_id
           FROM public.detalle_propiedad dp
          WHERE ((dp.vehiculo_id = oc.vehiculo_id) AND (dp.es_principal = true) AND (dp.estado = true))
         LIMIT 1)))))
     LEFT JOIN public.reserva r ON (((r.celda_id = c.id) AND (r.estado = ANY (ARRAY['PENDIENTE'::public.estado_reserva_enum, 'ACEPTADA'::public.estado_reserva_enum])) AND ((CURRENT_TIMESTAMP >= r.fecha_hora_inicio) AND (CURRENT_TIMESTAMP <= r.fecha_hora_fin)))));


--
-- Name: v_comparativo_ocupacion_parqueaderos; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_comparativo_ocupacion_parqueaderos AS
 SELECT p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    count(c.id) AS total_celdas,
    count(c.id) FILTER (WHERE (c.estado = 'DISPONIBLE'::public.estado_celda_enum)) AS celdas_disponibles,
    count(c.id) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)) AS celdas_ocupadas,
    count(c.id) FILTER (WHERE (c.estado = 'RESERVADA'::public.estado_celda_enum)) AS celdas_reservadas,
    round(
        CASE
            WHEN (count(c.id) = 0) THEN (0)::numeric
            ELSE (((count(c.id) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)))::numeric / (count(c.id))::numeric) * (100)::numeric)
        END, 2) AS porcentaje_ocupacion
   FROM (public.parqueadero p
     LEFT JOIN public.celda c ON ((c.parqueadero_id = p.id)))
  GROUP BY p.id, p.nombre, p.zona, p.piso;


--
-- Name: v_conductor_contacto; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_conductor_contacto AS
 SELECT co.id AS conductor_id,
    co.nombre_apellidos,
    co.tipo_documento,
    co.numero_documento,
    co.direccion,
    co.numero_telefonico,
    COALESCE(u.correo, co.correo) AS correo_principal,
    co.correo AS correo_contacto,
    u.correo AS correo_acceso,
    co.movilidad_reducida,
    tu.nombre AS tipo_usuario,
    co.vigencia,
    (u.id IS NOT NULL) AS tiene_cuenta,
    co.estado
   FROM ((public.conductor co
     LEFT JOIN public.usuario u ON ((u.id = co.usuario_id)))
     LEFT JOIN public.tipo_usuario tu ON ((tu.id = co.tipo_usuario_id)));


--
-- Name: v_conductor_front; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_conductor_front AS
 SELECT co.id,
    co.usuario_id,
    co.nombre_apellidos AS nombre,
    co.tipo_documento,
    co.numero_documento AS identificacion,
    COALESCE(u.correo, co.correo) AS email,
    co.numero_telefonico,
    co.direccion,
    tu.nombre AS tipo_conductor,
    co.centro_formacion,
    co.programa_formacion,
    co.movilidad_reducida AS discapacidad,
    co.tipo_discapacidad,
    co.vigencia,
    co.estado,
    v.id AS vehiculo_id,
    v.placa,
    v.tipo AS tipo_vehiculo
   FROM (((public.conductor co
     LEFT JOIN public.usuario u ON ((u.id = co.usuario_id)))
     LEFT JOIN public.tipo_usuario tu ON ((tu.id = co.tipo_usuario_id)))
     LEFT JOIN LATERAL ( SELECT ve.id,
            ve.placa,
            ve.tipo,
            ve.tarjeta_propiedad,
            ve.marca,
            ve.linea,
            ve.modelo,
            ve.cilindraje,
            ve.color,
            ve.servicio,
            ve.carroceria,
            ve.combustible,
            ve.capacidad,
            ve.numero_motor,
            ve.numero_chasis,
            ve.observaciones,
            ve.vehiculo_sena,
            ve.estado,
            ve.fecha_creacion
           FROM (public.detalle_propiedad dp
             JOIN public.vehiculo ve ON ((ve.id = dp.vehiculo_id)))
          WHERE ((dp.conductor_id = co.id) AND (dp.estado = true))
          ORDER BY dp.es_principal DESC, dp.id
         LIMIT 1) v ON (true));


--
-- Name: v_conflictos_reservas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_conflictos_reservas AS
 SELECT r1.id AS reserva_id,
    r2.id AS reserva_conflicto_id,
    r1.celda_id,
    c.numero AS numero_celda,
    p.nombre AS parqueadero,
    r1.fecha_hora_inicio AS inicio_1,
    r1.fecha_hora_fin AS fin_1,
    r2.fecha_hora_inicio AS inicio_2,
    r2.fecha_hora_fin AS fin_2
   FROM (((public.reserva r1
     JOIN public.reserva r2 ON (((r1.id < r2.id) AND (r1.celda_id = r2.celda_id) AND (r1.estado = ANY (ARRAY['PENDIENTE'::public.estado_reserva_enum, 'ACEPTADA'::public.estado_reserva_enum])) AND (r2.estado = ANY (ARRAY['PENDIENTE'::public.estado_reserva_enum, 'ACEPTADA'::public.estado_reserva_enum])) AND (r1.fecha_hora_inicio < r2.fecha_hora_fin) AND (r1.fecha_hora_fin > r2.fecha_hora_inicio))))
     JOIN public.celda c ON ((c.id = r1.celda_id)))
     JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)));


--
-- Name: v_control_placas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_control_placas AS
 SELECT v.id AS vehiculo_id,
    v.placa,
    v.marca,
    v.modelo,
    v.color,
    v.tipo,
    v.estado AS vehiculo_activo,
        CASE
            WHEN ((ra.id IS NOT NULL) AND (ra.fecha_hora_salida IS NULL)) THEN 'DENTRO'::text
            ELSE 'FUERA'::text
        END AS estado_ingreso_salida,
    ra.id AS registro_acceso_id,
    ra.fecha_hora_ingreso,
    ra.fecha_hora_salida,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    c.numero AS celda,
    co.nombre_apellidos AS propietario_conductor
   FROM ((((public.vehiculo v
     LEFT JOIN LATERAL ( SELECT ra2.id,
            ra2.vehiculo_id,
            ra2.conductor_id,
            ra2.parqueadero_id,
            ra2.celda_id,
            ra2.reserva_id,
            ra2.usuario_ingreso_id,
            ra2.usuario_salida_id,
            ra2.fecha_hora_ingreso,
            ra2.fecha_hora_salida,
            ra2.descripcion_ingreso,
            ra2.descripcion_salida,
            ra2.estado
           FROM public.registro_acceso ra2
          WHERE (ra2.vehiculo_id = v.id)
          ORDER BY ra2.fecha_hora_ingreso DESC
         LIMIT 1) ra ON (true))
     LEFT JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     LEFT JOIN public.celda c ON ((c.id = ra.celda_id)))
     LEFT JOIN LATERAL ( SELECT co2.id,
            co2.usuario_id,
            co2.tipo_documento,
            co2.numero_documento,
            co2.nombre_apellidos,
            co2.correo,
            co2.direccion,
            co2.numero_telefonico,
            co2.tipo_usuario_id,
            co2.regional_formacion,
            co2.centro_formacion,
            co2.programa_formacion,
            co2.vigencia,
            co2.movilidad_reducida,
            co2.estado,
            co2.fecha_creacion
           FROM (public.detalle_propiedad dp
             JOIN public.conductor co2 ON ((co2.id = dp.conductor_id)))
          WHERE ((dp.vehiculo_id = v.id) AND (dp.estado = true))
          ORDER BY dp.es_principal DESC, dp.id
         LIMIT 1) co ON (true));


--
-- Name: v_dashboard_desempeno; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_dashboard_desempeno AS
 SELECT p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    count(DISTINCT c.id) AS total_celdas,
    count(DISTINCT c.id) FILTER (WHERE (c.estado = 'DISPONIBLE'::public.estado_celda_enum)) AS disponibles,
    count(DISTINCT c.id) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)) AS ocupadas,
    count(DISTINCT c.id) FILTER (WHERE (c.estado = 'RESERVADA'::public.estado_celda_enum)) AS reservadas,
    count(DISTINCT ra.id) FILTER (WHERE (date(ra.fecha_hora_ingreso) = CURRENT_DATE)) AS ingresos_hoy,
    count(DISTINCT ra.id) FILTER (WHERE (date(ra.fecha_hora_salida) = CURRENT_DATE)) AS salidas_hoy,
    count(DISTINCT ra.vehiculo_id) FILTER (WHERE (ra.fecha_hora_salida IS NULL)) AS vehiculos_dentro,
    round(
        CASE
            WHEN (count(DISTINCT c.id) = 0) THEN (0)::numeric
            ELSE (((count(DISTINCT c.id) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)))::numeric / (count(DISTINCT c.id))::numeric) * (100)::numeric)
        END, 2) AS porcentaje_ocupacion
   FROM ((public.parqueadero p
     LEFT JOIN public.celda c ON ((c.parqueadero_id = p.id)))
     LEFT JOIN public.registro_acceso ra ON ((ra.parqueadero_id = p.id)))
  GROUP BY p.id, p.nombre, p.zona, p.piso;


--
-- Name: v_dashboard_parqueadero; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_dashboard_parqueadero AS
 SELECT count(id) AS total_celdas,
    count(id) FILTER (WHERE (estado = 'DISPONIBLE'::public.estado_celda_enum)) AS celdas_disponibles,
    count(id) FILTER (WHERE (estado = 'OCUPADA'::public.estado_celda_enum)) AS celdas_ocupadas,
    ( SELECT count(*) AS count
           FROM public.registro_acceso ra
          WHERE ((ra.fecha_hora_salida IS NULL) AND (ra.estado = 'DENTRO'::public.estado_acceso_enum))) AS vehiculos_estacionados,
    ( SELECT count(*) AS count
           FROM public.reserva r
          WHERE ((r.estado = 'ACEPTADA'::public.estado_reserva_enum) AND (r.fecha_hora_fin >= CURRENT_TIMESTAMP))) AS reservas_activas,
    ( SELECT count(*) AS count
           FROM public.novedad n
          WHERE (n.estado = ANY (ARRAY['PENDIENTE'::public.estado_novedad_enum, 'EN_PROCESO'::public.estado_novedad_enum]))) AS novedades_pendientes
   FROM public.celda c;


--
-- Name: valoracion; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.valoracion (
    id integer NOT NULL,
    encuesta_id integer NOT NULL,
    usuario_id integer NOT NULL,
    registro_acceso_id integer,
    calificacion smallint NOT NULL,
    comentario character varying(500),
    fecha_hora timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT ck_valoracion_calificacion CHECK (((calificacion >= 1) AND (calificacion <= 5)))
);


--
-- Name: TABLE valoracion; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.valoracion IS 'OPCIONAL — ver E-24';


--
-- Name: COLUMN valoracion.calificacion; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.valoracion.calificacion IS '1 a 5';


--
-- Name: v_desempeno_satisfaccion; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_desempeno_satisfaccion AS
 SELECT e.id AS encuesta_id,
    e.titulo,
    count(v.id) AS total_valoraciones,
    round(avg(v.calificacion), 2) AS promedio_calificacion,
    count(v.id) FILTER (WHERE (v.calificacion >= 4)) AS valoraciones_positivas,
    count(v.id) FILTER (WHERE (v.calificacion <= 2)) AS valoraciones_negativas
   FROM (public.encuesta e
     LEFT JOIN public.valoracion v ON ((v.encuesta_id = e.id)))
  GROUP BY e.id, e.titulo;


--
-- Name: v_disponibilidad_por_vigilante; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_disponibilidad_por_vigilante AS
 SELECT av.usuario_id AS vigilante_id,
    u.nombre AS vigilante,
    av.parqueadero_id,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    av.turno,
    av.fecha_inicio,
    av.fecha_fin,
    count(c.id) AS total_celdas,
    count(c.id) FILTER (WHERE (c.estado = 'DISPONIBLE'::public.estado_celda_enum)) AS libres,
    count(c.id) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)) AS ocupadas,
    count(c.id) FILTER (WHERE (c.estado = 'MANTENIMIENTO'::public.estado_celda_enum)) AS mantenimiento,
    count(c.id) FILTER (WHERE (c.estado = 'RESERVADA'::public.estado_celda_enum)) AS reservadas
   FROM (((public.asignacion_vigilante av
     JOIN public.usuario u ON ((u.id = av.usuario_id)))
     JOIN public.parqueadero p ON ((p.id = av.parqueadero_id)))
     LEFT JOIN public.celda c ON ((c.parqueadero_id = p.id)))
  GROUP BY av.usuario_id, u.nombre, av.parqueadero_id, p.nombre, p.zona, p.piso, av.turno, av.fecha_inicio, av.fecha_fin;


--
-- Name: v_historial_accesos; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_historial_accesos AS
 SELECT ra.id AS registro_acceso_id,
    v.placa,
    v.tipo AS tipo_vehiculo,
    co.nombre_apellidos AS conductor,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    c.numero AS celda,
    ra.fecha_hora_ingreso,
    ra.fecha_hora_salida,
    round(
        CASE
            WHEN (ra.fecha_hora_salida IS NULL) THEN NULL::numeric
            ELSE (EXTRACT(epoch FROM (ra.fecha_hora_salida - ra.fecha_hora_ingreso)) / 60.0)
        END, 2) AS permanencia_minutos,
    ra.estado,
    ui.nombre AS vigilante_ingreso,
    us.nombre AS vigilante_salida
   FROM ((((((public.registro_acceso ra
     JOIN public.vehiculo v ON ((v.id = ra.vehiculo_id)))
     LEFT JOIN public.conductor co ON ((co.id = ra.conductor_id)))
     JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     LEFT JOIN public.celda c ON ((c.id = ra.celda_id)))
     JOIN public.usuario ui ON ((ui.id = ra.usuario_ingreso_id)))
     LEFT JOIN public.usuario us ON ((us.id = ra.usuario_salida_id)));


--
-- Name: v_historial_novedades; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_historial_novedades AS
 SELECT h.id AS historial_id,
    h.novedad_id,
    n.tipo_novedad,
    n.descripcion,
    h.usuario_id,
    u.nombre AS usuario,
    h.accion,
    h.estado_anterior,
    h.estado_nuevo,
    h.prioridad_anterior,
    h.prioridad_nueva,
    h.comentario,
    h.fecha_hora
   FROM ((public.historial_novedad h
     JOIN public.novedad n ON ((n.id = h.novedad_id)))
     JOIN public.usuario u ON ((u.id = h.usuario_id)))
  ORDER BY h.fecha_hora DESC;


--
-- Name: v_incumplimientos_reservas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_incumplimientos_reservas AS
 SELECT ra.id AS registro_acceso_id,
    date(ra.fecha_hora_ingreso) AS fecha,
    ra.fecha_hora_ingreso,
    v.id AS vehiculo_id,
    v.placa,
    v.tipo AS tipo_vehiculo,
    c.id AS celda_id,
    c.numero AS numero_celda,
    c.usabilidad AS tipo_espacio,
    p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    co.id AS conductor_id,
    co.nombre_apellidos AS conductor,
    r.id AS reserva_id,
    r.usuario_id AS usuario_reserva_id,
    r.fecha_hora_inicio AS reserva_inicio,
    r.fecha_hora_fin AS reserva_fin,
        CASE
            WHEN (r.id IS NULL) THEN 'SIN_RESERVA'::text
            ELSE 'RESERVA_DE_OTRO_VEHICULO'::text
        END AS tipo_incumplimiento
   FROM (((((public.registro_acceso ra
     JOIN public.vehiculo v ON ((v.id = ra.vehiculo_id)))
     JOIN public.celda c ON ((c.id = ra.celda_id)))
     JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     LEFT JOIN public.conductor co ON ((co.id = ra.conductor_id)))
     LEFT JOIN LATERAL ( SELECT r2.id,
            r2.tipo_reserva,
            r2.celda_id,
            r2.usuario_registra_id AS usuario_id,
            r2.conductor_id,
            r2.vehiculo_id,
            r2.motivo,
            r2.fecha_hora_inicio,
            r2.fecha_hora_fin,
            r2.estado,
            r2.usuario_gestiona_id,
            r2.fecha_creacion
           FROM public.reserva r2
          WHERE ((r2.celda_id = ra.celda_id) AND (r2.estado = ANY (ARRAY['PENDIENTE'::public.estado_reserva_enum, 'ACEPTADA'::public.estado_reserva_enum])) AND (ra.fecha_hora_ingreso >= r2.fecha_hora_inicio) AND (ra.fecha_hora_ingreso < r2.fecha_hora_fin))
          ORDER BY r2.fecha_hora_inicio
         LIMIT 1) r ON (true))
  WHERE ((c.usabilidad = ANY (ARRAY['MOVILIDAD_REDUCIDA'::public.usabilidad_enum, 'EJECUTIVO'::public.usabilidad_enum, 'VEHICULO_SENA'::public.usabilidad_enum])) AND ((r.id IS NULL) OR (r.vehiculo_id IS DISTINCT FROM ra.vehiculo_id)));


--
-- Name: v_movimientos_front; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_movimientos_front AS
 SELECT ra.id,
    v.placa,
    'entrada'::text AS tipo,
    ra.fecha_hora_ingreso AS fecha,
    ra.parqueadero_id,
    p.nombre AS parqueadero,
    co.nombre_apellidos AS conductor_nombre
   FROM (((public.registro_acceso ra
     JOIN public.vehiculo v ON ((v.id = ra.vehiculo_id)))
     JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     LEFT JOIN public.conductor co ON ((co.id = ra.conductor_id)))
UNION ALL
 SELECT ra.id,
    v.placa,
    'salida'::text AS tipo,
    ra.fecha_hora_salida AS fecha,
    ra.parqueadero_id,
    p.nombre AS parqueadero,
    co.nombre_apellidos AS conductor_nombre
   FROM (((public.registro_acceso ra
     JOIN public.vehiculo v ON ((v.id = ra.vehiculo_id)))
     JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     LEFT JOIN public.conductor co ON ((co.id = ra.conductor_id)))
  WHERE (ra.fecha_hora_salida IS NOT NULL);


--
-- Name: v_novedades_pendientes; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_novedades_pendientes AS
 SELECT id AS novedad_id,
    tipo_novedad,
    prioridad,
    descripcion,
    estado,
    usuario_reporta_id,
    usuario_asignado_id,
    vehiculo_id,
    celda_id,
    parqueadero_id,
    registro_acceso_id,
    fecha_hora
   FROM public.novedad n
  WHERE (estado = ANY (ARRAY['PENDIENTE'::public.estado_novedad_enum, 'EN_PROCESO'::public.estado_novedad_enum]))
  ORDER BY fecha_hora DESC;


--
-- Name: v_ocupacion_historica_parqueadero; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_ocupacion_historica_parqueadero AS
 SELECT date(oc.fecha_hora_inicio) AS fecha,
    oc.celda_id,
    c.numero AS numero_celda,
    p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    p.zona,
    p.piso,
    v.tipo AS tipo_vehiculo,
    oc.fecha_hora_inicio,
    oc.fecha_hora_fin,
    (EXTRACT(hour FROM oc.fecha_hora_inicio))::integer AS hora_inicio,
    round(
        CASE
            WHEN (oc.fecha_hora_fin IS NULL) THEN (EXTRACT(epoch FROM (CURRENT_TIMESTAMP - (oc.fecha_hora_inicio)::timestamp with time zone)) / 60.0)
            ELSE (EXTRACT(epoch FROM (oc.fecha_hora_fin - oc.fecha_hora_inicio)) / 60.0)
        END, 2) AS minutos_ocupacion
   FROM (((public.ocupacion_celda oc
     JOIN public.celda c ON ((c.id = oc.celda_id)))
     JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)))
     JOIN public.vehiculo v ON ((v.id = oc.vehiculo_id)));


--
-- Name: v_ocupacion_hora_pico_valle; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_ocupacion_hora_pico_valle AS
 WITH horas AS (
         SELECT p.id AS parqueadero_id,
            p.nombre AS parqueadero,
            gs.hora,
            count(c.id) AS total_celdas
           FROM ((public.parqueadero p
             LEFT JOIN public.celda c ON ((c.parqueadero_id = p.id)))
             CROSS JOIN LATERAL generate_series(0, 23) gs(hora))
          GROUP BY p.id, p.nombre, gs.hora
        ), ocupadas AS (
         SELECT p.id AS parqueadero_id,
            (EXTRACT(hour FROM gs.hora))::integer AS hora,
            count(DISTINCT oc.celda_id) AS celdas_ocupadas
           FROM (((public.ocupacion_celda oc
             JOIN public.celda c ON ((c.id = oc.celda_id)))
             JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)))
             CROSS JOIN LATERAL generate_series((date_trunc('hour'::text, oc.fecha_hora_inicio))::timestamp with time zone, date_trunc('hour'::text, COALESCE((oc.fecha_hora_fin)::timestamp with time zone, CURRENT_TIMESTAMP)), '01:00:00'::interval) gs(hora))
          GROUP BY p.id, (EXTRACT(hour FROM gs.hora))
        )
 SELECT h.parqueadero_id,
    h.parqueadero,
    h.hora,
    h.total_celdas,
    COALESCE(o.celdas_ocupadas, (0)::bigint) AS celdas_ocupadas,
    round(
        CASE
            WHEN (h.total_celdas = 0) THEN (0)::numeric
            ELSE (((COALESCE(o.celdas_ocupadas, (0)::bigint))::numeric / (h.total_celdas)::numeric) * (100)::numeric)
        END, 2) AS porcentaje_ocupacion,
        CASE
            WHEN (round(
            CASE
                WHEN (h.total_celdas = 0) THEN (0)::numeric
                ELSE (((COALESCE(o.celdas_ocupadas, (0)::bigint))::numeric / (h.total_celdas)::numeric) * (100)::numeric)
            END, 2) >= (70)::numeric) THEN 'PICO'::text
            ELSE 'VALLE'::text
        END AS franja
   FROM (horas h
     LEFT JOIN ocupadas o ON (((o.parqueadero_id = h.parqueadero_id) AND (o.hora = h.hora))));


--
-- Name: v_ocupacion_por_franja; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_ocupacion_por_franja AS
 SELECT ra.parqueadero_id,
    p.nombre AS parqueadero,
    (EXTRACT(hour FROM ra.fecha_hora_ingreso))::integer AS hora,
    v.tipo AS tipo_vehiculo,
    count(*) AS ingresos,
    count(*) FILTER (WHERE (ra.fecha_hora_salida IS NULL)) AS activos
   FROM ((public.registro_acceso ra
     JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     JOIN public.vehiculo v ON ((v.id = ra.vehiculo_id)))
  GROUP BY ra.parqueadero_id, p.nombre, (EXTRACT(hour FROM ra.fecha_hora_ingreso)), v.tipo;


--
-- Name: v_ocupacion_por_hora; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_ocupacion_por_hora AS
 SELECT date_trunc('hour'::text, fecha_hora_ingreso) AS hora,
    count(*) AS ingresos,
    count(*) FILTER (WHERE (fecha_hora_salida IS NULL)) AS actualmente_estacionados,
    count(*) FILTER (WHERE (fecha_hora_salida IS NOT NULL)) AS salidas
   FROM public.registro_acceso ra
  GROUP BY (date_trunc('hour'::text, fecha_hora_ingreso))
  ORDER BY (date_trunc('hour'::text, fecha_hora_ingreso)) DESC;


--
-- Name: v_parqueadero_front; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_parqueadero_front AS
SELECT
    NULL::integer AS id,
    NULL::character varying(100) AS nombre,
    NULL::character varying(255) AS direccion,
    NULL::character varying(255) AS descripcion,
    NULL::public.tipo_parqueadero_enum AS tipo,
    NULL::public.acceso_enum AS acceso,
    NULL::character varying(100) AS bloque,
    NULL::character varying(50) AS piso,
    NULL::integer AS capacidad,
    NULL::time without time zone AS hora_inicio,
    NULL::time without time zone AS hora_fin,
    NULL::boolean AS estado,
    NULL::bigint AS celdas_totales,
    NULL::bigint AS celdas_carros,
    NULL::bigint AS celdas_motos,
    NULL::bigint AS celdas_bicicletas,
    NULL::bigint AS celdas_movilidad_reducida,
    NULL::bigint AS celdas_disponibles,
    NULL::bigint AS celdas_ocupadas;


--
-- Name: v_parqueaderos_con_capacidad; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_parqueaderos_con_capacidad AS
 SELECT p.id AS parqueadero_id,
    p.nombre,
    p.ubicacion,
    p.zona,
    p.piso,
    p.acceso,
    p.capacidad_maxima,
    count(c.id) AS celdas_registradas,
    count(c.id) FILTER (WHERE (c.estado = 'DISPONIBLE'::public.estado_celda_enum)) AS disponibles,
    count(c.id) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)) AS ocupadas,
    count(c.id) FILTER (WHERE (c.estado = 'RESERVADA'::public.estado_celda_enum)) AS reservadas,
    count(c.id) FILTER (WHERE (c.estado = 'MANTENIMIENTO'::public.estado_celda_enum)) AS mantenimiento,
    count(c.id) FILTER (WHERE (c.estado = 'INACTIVA'::public.estado_celda_enum)) AS inactivas,
    p.estado
   FROM (public.parqueadero p
     LEFT JOIN public.celda c ON ((c.parqueadero_id = p.id)))
  GROUP BY p.id, p.nombre, p.ubicacion, p.zona, p.piso, p.acceso, p.capacidad_maxima, p.estado;


--
-- Name: v_reconocimiento_placas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_reconocimiento_placas AS
 SELECT cp.id AS captura_id,
    cp.placa_detectada,
    cp.placa_normalizada,
    cp.confianza,
    cp.motor_ocr,
    cp.procesada,
    cp.verificada,
    cp.direccion_captura,
    cp.fecha_hora,
    cp.fecha_procesamiento,
    cp.error_ocr,
    cp.vehiculo_id,
    v.placa AS placa_registrada,
    v.tipo AS tipo_vehiculo,
    cp.parqueadero_id,
    p.nombre AS parqueadero,
    cp.registro_acceso_id
   FROM ((public.captura_placa cp
     LEFT JOIN public.vehiculo v ON ((v.id = cp.vehiculo_id)))
     JOIN public.parqueadero p ON ((p.id = cp.parqueadero_id)));


--
-- Name: v_reservas_activas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_reservas_activas AS
 SELECT r.id AS reserva_id,
    r.tipo_reserva,
    r.usuario_registra_id AS usuario_id,
    r.conductor_id,
    r.vehiculo_id,
    v.placa,
    r.celda_id,
    c.numero AS numero_celda,
    r.fecha_hora_inicio,
    r.fecha_hora_fin,
    r.estado,
    r.motivo
   FROM ((public.reserva r
     JOIN public.vehiculo v ON ((v.id = r.vehiculo_id)))
     LEFT JOIN public.celda c ON ((c.id = r.celda_id)))
  WHERE ((r.estado = ANY (ARRAY['PENDIENTE'::public.estado_reserva_enum, 'ACEPTADA'::public.estado_reserva_enum])) AND (r.fecha_hora_fin >= CURRENT_TIMESTAMP));


--
-- Name: v_reservas_celdas_exclusivas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_reservas_celdas_exclusivas AS
 SELECT r.id AS reserva_id,
    r.tipo_reserva,
    r.estado,
    r.fecha_hora_inicio,
    r.fecha_hora_fin,
    v.placa,
    v.tipo AS tipo_vehiculo,
    u.nombre AS usuario,
    c.numero AS numero_celda,
    c.tipo AS tipo_celda,
    c.usabilidad AS tipo_espacio,
    p.nombre AS parqueadero,
    p.zona,
    p.piso
   FROM ((((public.reserva r
     JOIN public.celda c ON ((c.id = r.celda_id)))
     JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)))
     LEFT JOIN public.vehiculo v ON ((v.id = r.vehiculo_id)))
     JOIN public.usuario u ON ((u.id = r.usuario_registra_id)))
  WHERE (c.usabilidad = ANY (ARRAY['MOVILIDAD_REDUCIDA'::public.usabilidad_enum, 'EJECUTIVO'::public.usabilidad_enum, 'VEHICULO_SENA'::public.usabilidad_enum]));


--
-- Name: v_reservas_con_detalle; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_reservas_con_detalle AS
 SELECT r.id AS reserva_id,
    r.tipo_reserva,
    r.estado,
    r.fecha_hora_inicio,
    r.fecha_hora_fin,
    r.motivo,
    r.usuario_registra_id AS usuario_id,
    u.nombre AS usuario,
    r.conductor_id,
    co.nombre_apellidos AS conductor,
    r.vehiculo_id,
    v.placa,
    v.tipo AS tipo_vehiculo,
    r.celda_id,
    c.numero AS numero_celda,
    c.tipo AS tipo_celda,
    c.usabilidad AS tipo_espacio,
    p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    p.zona,
    p.piso
   FROM (((((public.reserva r
     JOIN public.usuario u ON ((u.id = r.usuario_registra_id)))
     LEFT JOIN public.conductor co ON ((co.id = r.conductor_id)))
     LEFT JOIN public.vehiculo v ON ((v.id = r.vehiculo_id)))
     JOIN public.celda c ON ((c.id = r.celda_id)))
     JOIN public.parqueadero p ON ((p.id = c.parqueadero_id)));


--
-- Name: v_resumen_celdas; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_resumen_celdas AS
 SELECT p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    count(c.id) AS total_celdas,
    count(c.id) FILTER (WHERE (c.estado = 'DISPONIBLE'::public.estado_celda_enum)) AS celdas_disponibles,
    count(c.id) FILTER (WHERE (c.estado = 'OCUPADA'::public.estado_celda_enum)) AS celdas_ocupadas,
    count(c.id) FILTER (WHERE (c.estado = ANY (ARRAY['RESERVADA'::public.estado_celda_enum, 'MANTENIMIENTO'::public.estado_celda_enum, 'INACTIVA'::public.estado_celda_enum]))) AS celdas_no_disponibles
   FROM (public.parqueadero p
     LEFT JOIN public.celda c ON ((c.parqueadero_id = p.id)))
  GROUP BY p.id, p.nombre;


--
-- Name: v_rol_permisos_front; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_rol_permisos_front AS
SELECT
    NULL::integer AS id,
    NULL::character varying(50) AS nombre,
    NULL::character varying(255) AS descripcion,
    NULL::boolean AS estado,
    NULL::jsonb AS permisos;


--
-- Name: v_rotacion_diaria; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_rotacion_diaria AS
 SELECT date(ra.fecha_hora_ingreso) AS fecha,
    ra.parqueadero_id,
    p.nombre AS parqueadero,
    ra.celda_id,
    c.numero AS numero_celda,
    count(DISTINCT ra.vehiculo_id) AS vehiculos_diferentes,
    count(*) AS ingresos,
    count(*) FILTER (WHERE (ra.fecha_hora_salida IS NOT NULL)) AS salidas,
    round(avg((EXTRACT(epoch FROM (ra.fecha_hora_salida - ra.fecha_hora_ingreso)) / 60.0)), 2) AS permanencia_promedio_minutos
   FROM ((public.registro_acceso ra
     JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     LEFT JOIN public.celda c ON ((c.id = ra.celda_id)))
  GROUP BY (date(ra.fecha_hora_ingreso)), ra.parqueadero_id, p.nombre, ra.celda_id, c.numero;


--
-- Name: v_uso_por_tipo_usuario; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_uso_por_tipo_usuario AS
 SELECT p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    tu.id AS tipo_usuario_id,
    tu.nombre AS tipo_usuario,
    count(ra.id) AS movimientos,
    count(ra.id) FILTER (WHERE (ra.fecha_hora_salida IS NULL)) AS actualmente_dentro
   FROM (((public.registro_acceso ra
     JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
     LEFT JOIN public.conductor c ON ((c.id = ra.conductor_id)))
     LEFT JOIN public.tipo_usuario tu ON ((tu.id = c.tipo_usuario_id)))
  GROUP BY p.id, p.nombre, tu.id, tu.nombre;


--
-- Name: v_vehiculo_conductor; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_vehiculo_conductor AS
 SELECT v.id AS vehiculo_id,
    v.placa,
    v.tipo,
    v.marca,
    v.linea,
    v.color,
    v.vehiculo_sena,
    co.id AS conductor_id,
    co.nombre_apellidos AS conductor,
    co.numero_documento,
    co.correo
   FROM ((public.vehiculo v
     LEFT JOIN public.detalle_propiedad dp ON (((dp.vehiculo_id = v.id) AND (dp.es_principal = true) AND (dp.estado = true))))
     LEFT JOIN public.conductor co ON ((co.id = dp.conductor_id)));


--
-- Name: v_vehiculo_front; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_vehiculo_front AS
 SELECT v.id,
    v.placa,
    v.tipo,
    v.marca,
    v.linea AS modelo,
    v.modelo AS anio,
    v.color,
    v.observaciones AS descripcion,
    v.vehiculo_sena,
    v.estado,
    co.id AS conductor_id,
    co.nombre_apellidos AS conductor,
    ra.parqueadero_id,
    ra.celda_id,
    c.numero AS celda,
    ra.fecha_hora_ingreso AS fecha_entrada,
    (ra.id IS NOT NULL) AS esta_dentro
   FROM (((public.vehiculo v
     LEFT JOIN LATERAL ( SELECT co2.id,
            co2.usuario_id,
            co2.tipo_documento,
            co2.numero_documento,
            co2.nombre_apellidos,
            co2.correo,
            co2.direccion,
            co2.numero_telefonico,
            co2.tipo_usuario_id,
            co2.regional_formacion,
            co2.centro_formacion,
            co2.programa_formacion,
            co2.vigencia,
            co2.movilidad_reducida,
            co2.estado,
            co2.fecha_creacion,
            co2.tipo_discapacidad
           FROM (public.detalle_propiedad dp
             JOIN public.conductor co2 ON ((co2.id = dp.conductor_id)))
          WHERE ((dp.vehiculo_id = v.id) AND (dp.estado = true))
          ORDER BY dp.es_principal DESC, dp.id
         LIMIT 1) co ON (true))
     LEFT JOIN LATERAL ( SELECT ra2.id,
            ra2.vehiculo_id,
            ra2.conductor_id,
            ra2.parqueadero_id,
            ra2.celda_id,
            ra2.reserva_id,
            ra2.usuario_ingreso_id,
            ra2.usuario_salida_id,
            ra2.fecha_hora_ingreso,
            ra2.fecha_hora_salida,
            ra2.descripcion_ingreso,
            ra2.descripcion_salida,
            ra2.estado
           FROM public.registro_acceso ra2
          WHERE ((ra2.vehiculo_id = v.id) AND (ra2.fecha_hora_salida IS NULL))
          ORDER BY ra2.fecha_hora_ingreso DESC
         LIMIT 1) ra ON (true))
     LEFT JOIN public.celda c ON ((c.id = ra.celda_id)));


--
-- Name: v_vehiculos_estacionados; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.v_vehiculos_estacionados AS
 SELECT ra.id AS registro_acceso_id,
    v.id AS vehiculo_id,
    v.placa,
    v.tipo,
    v.marca,
    v.linea,
    c.id AS celda_id,
    c.numero AS numero_celda,
    p.id AS parqueadero_id,
    p.nombre AS parqueadero,
    ra.fecha_hora_ingreso,
    ra.descripcion_ingreso
   FROM (((public.registro_acceso ra
     JOIN public.vehiculo v ON ((v.id = ra.vehiculo_id)))
     LEFT JOIN public.celda c ON ((c.id = ra.celda_id)))
     LEFT JOIN public.parqueadero p ON ((p.id = ra.parqueadero_id)))
  WHERE ((ra.fecha_hora_salida IS NULL) AND (ra.estado = 'DENTRO'::public.estado_acceso_enum));


--
-- Name: valoracion_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.valoracion ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.valoracion_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: vehiculo_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.vehiculo ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.vehiculo_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


