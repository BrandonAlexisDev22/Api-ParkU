--
-- Name: fn_auditar_vehiculo(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_auditar_vehiculo() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        INSERT INTO "auditoria"
        (
            tabla_afectada,
            registro_id,
            accion,
            fecha_hora,
            valor_nuevo
        )
        VALUES
        (
            'vehiculo',
            NEW.id,
            'CREAR'::accion_auditoria_enum,
            CURRENT_TIMESTAMP,
            to_jsonb(NEW)
        );
        RETURN NEW;

    ELSIF TG_OP = 'UPDATE' THEN
        INSERT INTO "auditoria"
        (
            tabla_afectada,
            registro_id,
            accion,
            fecha_hora,
            valor_anterior,
            valor_nuevo
        )
        VALUES
        (
            'vehiculo',
            NEW.id,
            CASE
                WHEN OLD.estado IS DISTINCT FROM NEW.estado
                    THEN 'CAMBIAR_ESTADO'::accion_auditoria_enum
                ELSE 'EDITAR'::accion_auditoria_enum
            END,
            CURRENT_TIMESTAMP,
            to_jsonb(OLD),
            to_jsonb(NEW)
        );
        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN
        INSERT INTO "auditoria"
        (
            tabla_afectada,
            registro_id,
            accion,
            fecha_hora,
            valor_anterior
        )
        VALUES
        (
            'vehiculo',
            OLD.id,
            'ELIMINAR'::accion_auditoria_enum,
            CURRENT_TIMESTAMP,
            to_jsonb(OLD)
        );
        RETURN OLD;
    END IF;

    RETURN NULL;
END;
$$;


--
-- Name: fn_auditoria_generica(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_auditoria_generica() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_usuario_id INT;
    v_motivo     VARCHAR(255);
    v_accion     accion_auditoria_enum;
    v_registro   INT;
BEGIN
    v_usuario_id := NULLIF(current_setting('app.usuario_id', true), '')::INT;
    v_motivo     := NULLIF(current_setting('app.motivo', true), '');

    IF v_usuario_id IS NULL THEN
        RAISE EXCEPTION
          'La operacion requiere contexto de usuario. Use SET LOCAL app.usuario_id = ''<id>''.';
    END IF;

    IF TG_OP = 'INSERT' THEN
        v_accion := 'CREAR';    v_registro := NEW.id;
    ELSIF TG_OP = 'DELETE' THEN
        v_accion := 'ELIMINAR'; v_registro := OLD.id;
    ELSE
        v_registro := NEW.id;
        IF to_jsonb(NEW) ->> 'estado' IS DISTINCT FROM to_jsonb(OLD) ->> 'estado' THEN
            v_accion := 'CAMBIAR_ESTADO';
            -- Motivo obligatorio SOLO en parqueadero (HU 03.1.6.2).
            IF TG_TABLE_NAME = 'parqueadero' AND v_motivo IS NULL THEN
                RAISE EXCEPTION
                  'El motivo es obligatorio para cambiar el estado de un parqueadero.';
            END IF;
        ELSE
            v_accion := 'EDITAR';
        END IF;
    END IF;

    INSERT INTO auditoria (tabla_afectada, registro_id, accion, usuario_id, motivo,
                           valor_anterior, valor_nuevo)
    VALUES (TG_TABLE_NAME, v_registro, v_accion, v_usuario_id, v_motivo,
            CASE WHEN TG_OP = 'INSERT' THEN NULL ELSE to_jsonb(OLD) END,
            CASE WHEN TG_OP = 'DELETE' THEN NULL ELSE to_jsonb(NEW) END);

    RETURN COALESCE(NEW, OLD);
END;
$$;


--
-- Name: fn_celdas_disponibles_para(integer); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_celdas_disponibles_para(p_conductor_id integer) RETURNS TABLE(celda_id integer, numero character varying, parqueadero character varying, tipo public.tipo_vehiculo_enum, usabilidad public.usabilidad_enum)
    LANGUAGE sql STABLE
    AS $$
    SELECT c.id, c.numero, p.nombre, c.tipo, c.usabilidad
      FROM celda c
      JOIN parqueadero p ON p.id = c.parqueadero_id
     WHERE c.estado = 'DISPONIBLE'
       AND (c.usabilidad <> 'MOVILIDAD_REDUCIDA'
            OR EXISTS (SELECT 1 FROM conductor co
                        WHERE co.id = p_conductor_id
                          AND co.movilidad_reducida = TRUE))
     ORDER BY p.nombre, c.numero;
$$;


