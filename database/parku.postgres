END;
$$;


--
-- Name: fn_contexto_usuario_id(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_contexto_usuario_id() RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_id INT;
BEGIN
    BEGIN
        v_id := NULLIF(current_setting('app.usuario_id', true), '')::INT;
    EXCEPTION WHEN OTHERS THEN
        v_id := NULL;
    END;
    RETURN v_id;
END;
$$;


--
-- Name: fn_historial_celda(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_historial_celda() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_usuario_id INT := "fn_contexto_usuario_id"();
BEGIN
    IF v_usuario_id IS NULL THEN
        RAISE EXCEPTION 'La operación requiere usuario autenticado.';
    END IF;

    INSERT INTO "historial_celda" (
        "celda_id", "usuario_id", "accion",
        "estado_anterior", "estado_nuevo", "motivo"
    ) VALUES (
        NEW.id, v_usuario_id,
        CASE WHEN TG_OP = 'INSERT' THEN 'CREAR' WHEN OLD.estado IS DISTINCT FROM NEW.estado THEN 'CAMBIO_ESTADO' ELSE 'EDICION' END,
        CASE WHEN TG_OP = 'UPDATE' THEN OLD.estado END,
        NEW.estado,
        "fn_contexto_motivo"()
    );
    RETURN NEW;
END;
$$;


--
-- Name: fn_historial_novedad(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_historial_novedad() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_usuario_id int;
    v_accion varchar(50);
BEGIN
    -- El backend debe establecer:
    -- SET LOCAL app.usuario_id = '123';
    -- Si no existe un usuario de sesión válido, no se crea
    -- automáticamente el historial para evitar romper el CRUD.
    BEGIN
        v_usuario_id := NULLIF(current_setting('app.usuario_id', true), '')::int;
    EXCEPTION WHEN OTHERS THEN
        v_usuario_id := NULL;
    END;

    IF v_usuario_id IS NULL THEN
        RETURN NEW;
    END IF;

    IF TG_OP = 'INSERT' THEN
        v_accion := 'CREAR';

        INSERT INTO "historial_novedad" (
            "novedad_id",
            "usuario_id",
            "accion",
            "estado_nuevo",
            "prioridad_nueva"
        )
        VALUES (
            NEW.id,
            v_usuario_id,
            v_accion,
            NEW.estado,
            NEW.prioridad
        );

        RETURN NEW;
    END IF;

    IF TG_OP = 'UPDATE' THEN

        IF OLD.estado IS DISTINCT FROM NEW.estado THEN
            v_accion := 'CAMBIO_ESTADO';
        ELSIF OLD.prioridad IS DISTINCT FROM NEW.prioridad THEN
            v_accion := 'CAMBIO_PRIORIDAD';
        ELSE
            v_accion := 'EDICION';
        END IF;

        INSERT INTO "historial_novedad" (
            "novedad_id",
            "usuario_id",
            "accion",
            "estado_anterior",
            "estado_nuevo",
            "prioridad_anterior",
            "prioridad_nueva"
        )
        VALUES (
            NEW.id,
            v_usuario_id,
            v_accion,
            OLD.estado,
            NEW.estado,
            OLD.prioridad,
            NEW.prioridad
        );

        RETURN NEW;
    END IF;

    RETURN NEW;
END;
$$;


