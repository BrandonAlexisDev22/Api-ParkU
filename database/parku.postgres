--

CREATE TABLE public.parqueadero (
    id integer NOT NULL,
    nombre character varying(100) NOT NULL,
    ubicacion character varying(255) NOT NULL,
    acceso public.acceso_enum NOT NULL,
    capacidad_maxima integer DEFAULT 0 NOT NULL,
    hora_apertura time without time zone,
    hora_cierre time without time zone,
    estado boolean DEFAULT true NOT NULL,
    zona character varying(100),
    piso character varying(50),
    plano_url character varying(500),
    observaciones character varying(500),
    descripcion character varying(255),
    tipo public.tipo_parqueadero_enum DEFAULT 'GENERAL'::public.tipo_parqueadero_enum NOT NULL,
    CONSTRAINT ck_parqueadero_capacidad CHECK ((capacidad_maxima >= 0))
);


--
-- Name: TABLE parqueadero; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.parqueadero IS 'Proceso 03.1. E-39: se eliminaron los 7 contadores de celdas (celdas_totales, celdas_motos, celdas_camion...). Ahora se calculan en la vista v_capacidad_parqueadero para que nunca queden desincronizados.';


--
-- Name: COLUMN parqueadero.acceso; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.parqueadero.acceso IS 'Porteria por la que se accede: REGIONAL o AVENIDA_BOYACA. No confundir con tipo.';


--
-- Name: COLUMN parqueadero.hora_apertura; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.parqueadero.hora_apertura IS 'E-10: exigido por HU 03.1.1.1';


--
-- Name: COLUMN parqueadero.hora_cierre; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.parqueadero.hora_cierre IS 'E-10: exigido por HU 03.1.1.1';


--
-- Name: COLUMN parqueadero.tipo; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.parqueadero.tipo IS 'Publico objetivo del parqueadero. Lo usa la asignacion inteligente del frontend para sugerir zona. Distinto de acceso, que indica por cual porteria se ingresa.';


