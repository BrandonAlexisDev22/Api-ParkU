END;
$$;


--
-- Name: fn_historial_reserva(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_historial_reserva() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_usuario_id INT := "fn_contexto_usuario_id"();
BEGIN
    IF v_usuario_id IS NULL THEN
        RAISE EXCEPTION 'La modificación de una reserva requiere usuario autenticado.';
    END IF;

    INSERT INTO "historial_reserva" (
        "reserva_id", "usuario_id", "accion",
        "estado_anterior", "estado_nuevo",
        "fecha_inicio_anterior", "fecha_inicio_nueva",
        "fecha_fin_anterior", "fecha_fin_nueva",
        "celda_anterior_id", "celda_nueva_id",
        "motivo"
    ) VALUES (
        NEW.id,
        v_usuario_id,
        CASE WHEN TG_OP = 'INSERT' THEN 'CREAR' ELSE 'EDICION' END,
        CASE WHEN TG_OP = 'UPDATE' THEN OLD.estado END,
        NEW.estado,
        CASE WHEN TG_OP = 'UPDATE' THEN OLD.fecha_hora_inicio END,
        NEW.fecha_hora_inicio,
        CASE WHEN TG_OP = 'UPDATE' THEN OLD.fecha_hora_fin END,
        NEW.fecha_hora_fin,
        CASE WHEN TG_OP = 'UPDATE' THEN OLD.celda_id END,
        NEW.celda_id,
        "fn_contexto_motivo"()
    );

    RETURN NEW;
END;
$$;


--
-- Name: fn_normalizar_placa(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_normalizar_placa() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW.placa_detectada IS NOT NULL THEN
        NEW.placa_normalizada :=
            UPPER(
                REGEXP_REPLACE(
                    TRIM(NEW.placa_detectada),
                    '[^A-Za-z0-9]',
                    '',
                    'g'
                )
            );
    END IF;

    IF NEW.placa_normalizada IS NULL
       AND NEW.placa_detectada IS NOT NULL THEN
        NEW.placa_normalizada :=
            UPPER(
                REGEXP_REPLACE(
                    TRIM(NEW.placa_detectada),
                    '[^A-Za-z0-9]',
                    '',
                    'g'
                )
            );
    END IF;

    RETURN NEW;
END;
$$;


--
-- Name: fn_notificar_administradores(character varying, character varying, public.tipo_notificacion_enum, character varying, integer); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_notificar_administradores(p_titulo character varying, p_mensaje character varying, p_tipo public.tipo_notificacion_enum, p_tabla character varying, p_id integer) RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
    INSERT INTO "notificacion" (
        "usuario_id", "titulo", "mensaje", "tipo",
        "referencia_tabla", "referencia_id", "leida", "fecha_hora"
    )
    SELECT
        u.id,
        p_titulo,
        p_mensaje,
        p_tipo,
        p_tabla,
        p_id,
        false,
        CURRENT_TIMESTAMP
    FROM "usuario" u
    INNER JOIN "rol" r ON r.id = u.rol_id
    WHERE LOWER(r.nombre) = 'administrador'
      AND u.estado = 'ACTIVO'::estado_usuario_enum;
END;
$$;


--
-- Name: fn_notificar_cambio_novedad(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_notificar_cambio_novedad() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        PERFORM "fn_notificar_administradores"(
            'Nueva novedad',
            'Se registró la novedad #' || NEW.id || '.',
            'NOVEDAD'::tipo_notificacion_enum,
            'novedad',
            NEW.id
        );
    ELSIF TG_OP = 'UPDATE' THEN
        PERFORM "fn_notificar_administradores"(
            'Novedad actualizada',
            'La novedad #' || NEW.id || ' fue actualizada.',
            'NOVEDAD'::tipo_notificacion_enum,
            'novedad',
            NEW.id
        );
    END IF;
    RETURN NEW;
END;
$$;


--
-- Name: fn_notificar_cambio_reserva(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_notificar_cambio_reserva() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF TG_OP = 'UPDATE' THEN
        PERFORM "fn_notificar_administradores"(
            'Reserva actualizada',
            'La reserva #' || NEW.id || ' fue modificada.',
            'RESERVA'::tipo_notificacion_enum,
            'reserva',
            NEW.id
        );
    END IF;
    RETURN NEW;
END;
$$;


--
-- Name: fn_registro_ingreso_celda(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_registro_ingreso_celda() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW.celda_id IS NOT NULL THEN

        -- Primero la ocupacion: dispara fn_validar_ocupacion_celda
        INSERT INTO ocupacion_celda
            (celda_id, vehiculo_id, registro_acceso_id, reserva_id,
             usuario_asigna_id, fecha_hora_inicio, estado)
        VALUES
            (NEW.celda_id, NEW.vehiculo_id, NEW.id, NEW.reserva_id,
             NEW.usuario_ingreso_id,
             COALESCE(NEW.fecha_hora_ingreso, CURRENT_TIMESTAMP), 'ACTIVA');

        -- Solo si la validacion paso, se marca la celda
        UPDATE celda SET estado = 'OCUPADA' WHERE id = NEW.celda_id;
    END IF;

    RETURN NEW;
END;
$$;


--
-- Name: fn_registro_salida_celda(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_registro_salida_celda() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_tiene_reserva BOOLEAN;
BEGIN
    IF NEW.fecha_hora_salida IS NOT NULL AND OLD.fecha_hora_salida IS NULL THEN

        UPDATE ocupacion_celda
           SET fecha_hora_fin = NEW.fecha_hora_salida,
               estado         = 'FINALIZADA'
         WHERE registro_acceso_id = NEW.id
           AND estado = 'ACTIVA';

        IF NEW.celda_id IS NOT NULL THEN
            SELECT EXISTS (
                SELECT 1 FROM reserva r
                 WHERE r.celda_id = NEW.celda_id
                   AND r.estado = 'ACEPTADA'
                   AND NEW.fecha_hora_salida BETWEEN r.fecha_hora_inicio
                                                 AND r.fecha_hora_fin
            ) INTO v_tiene_reserva;

            UPDATE celda
               SET estado = CASE WHEN v_tiene_reserva THEN 'RESERVADA'::estado_celda_enum
                                 ELSE 'DISPONIBLE'::estado_celda_enum END
             WHERE id = NEW.celda_id;
        END IF;
    END IF;

    RETURN NEW;
END;
$$;


--
-- Name: fn_reserva_bloquea_celda(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_reserva_bloquea_celda() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Al aceptar: la celda pasa a RESERVADA (solo si estaba libre)
    IF NEW.estado = 'ACEPTADA'
       AND (TG_OP = 'INSERT' OR OLD.estado IS DISTINCT FROM 'ACEPTADA') THEN
        UPDATE celda SET estado = 'RESERVADA'
         WHERE id = NEW.celda_id AND estado = 'DISPONIBLE';
    END IF;

    -- Al cancelar, rechazar o terminar: se libera, salvo que este ocupada
    IF TG_OP = 'UPDATE'
       AND OLD.estado = 'ACEPTADA'
       AND NEW.estado IN ('CANCELADA','RECHAZADA','TERMINADA') THEN
        UPDATE celda SET estado = 'DISPONIBLE'
         WHERE id = NEW.celda_id AND estado = 'RESERVADA';
    END IF;

    RETURN NEW;
END;
$$;


--
-- Name: fn_sincronizar_disponibilidad(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_sincronizar_disponibilidad() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_usuario_id INT;
    v_motivo motivo_disponibilidad_enum;
    v_observacion varchar(500);
    v_anterior estado_celda_enum;
BEGIN
    v_usuario_id := "fn_contexto_usuario_id"();

    IF v_usuario_id IS NULL THEN
        RAISE EXCEPTION 'La modificación de disponibilidad requiere usuario autenticado.';
    END IF;

    BEGIN
        v_motivo := NULLIF(current_setting('app.motivo_disponibilidad', true), '')::motivo_disponibilidad_enum;
    EXCEPTION WHEN OTHERS THEN
        v_motivo := NULL;
    END;

    v_observacion := NULLIF(current_setting('app.observacion', true), '');

    IF v_motivo IS NULL THEN
        RAISE EXCEPTION 'El motivo es obligatorio al modificar disponibilidad.';
    END IF;

    SELECT estado INTO v_anterior FROM "celda" WHERE id = NEW.celda_id;

    INSERT INTO "historial_disponibilidad_celda" (
        "celda_id", "estado_anterior", "estado_nuevo", "motivo", "observacion", "usuario_id"
    ) VALUES (
        NEW.celda_id, v_anterior, NEW.estado, v_motivo, v_observacion, v_usuario_id
    );

    UPDATE "celda"
       SET "estado" = NEW.estado
     WHERE "id" = NEW.celda_id;

    RETURN NEW;
END;
$$;


--
-- Name: fn_sugerir_celda(integer, integer); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_sugerir_celda(p_conductor_id integer, p_vehiculo_id integer) RETURNS TABLE(celda_id integer, numero character varying, parqueadero character varying, usabilidad public.usabilidad_enum, motivo text)
    LANGUAGE plpgsql STABLE
    AS $$
DECLARE
    v_tipo    tipo_vehiculo_enum;
    v_apto    BOOLEAN;
    v_tipo_pq tipo_parqueadero_enum;
BEGIN
    SELECT ve.tipo INTO v_tipo FROM vehiculo ve WHERE ve.id = p_vehiculo_id;
    SELECT co.movilidad_reducida INTO v_apto FROM conductor co WHERE co.id = p_conductor_id;

    SELECT CASE tu.nombre
             WHEN 'Instructor'     THEN 'DOCENTES'
             WHEN 'Administrativo' THEN 'ADMINISTRATIVOS'
             WHEN 'Aprendiz'       THEN 'APRENDICES'
             WHEN 'Visitante'      THEN 'VISITANTES'
             ELSE 'GENERAL' END::tipo_parqueadero_enum
      INTO v_tipo_pq
      FROM conductor co JOIN tipo_usuario tu ON tu.id = co.tipo_usuario_id
     WHERE co.id = p_conductor_id;

    RETURN QUERY
    SELECT c.id, c.numero, p.nombre, c.usabilidad,
           CASE
             WHEN c.usabilidad = 'MOVILIDAD_REDUCIDA' THEN 'Celda preferencial disponible'
             WHEN p.tipo = v_tipo_pq                  THEN 'Zona correspondiente al perfil'
             ELSE 'Zona general'
           END::TEXT
      FROM celda c
      JOIN parqueadero p ON p.id = c.parqueadero_id
     WHERE c.estado = 'DISPONIBLE'
       AND p.estado = TRUE
       AND c.tipo = v_tipo
       AND (c.usabilidad <> 'MOVILIDAD_REDUCIDA' OR COALESCE(v_apto, FALSE))
     ORDER BY
       -- 1) si tiene condicion, primero las preferenciales
       (COALESCE(v_apto, FALSE) AND c.usabilidad = 'MOVILIDAD_REDUCIDA') DESC,
       -- 2) luego la zona que corresponde a su perfil
       (p.tipo = v_tipo_pq) DESC,
       p.nombre, c.numero;
END;
$$;


--
-- Name: fn_usuario_autorizado_acceso(integer, integer, integer, timestamp without time zone); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_usuario_autorizado_acceso(p_usuario_id integer, p_conductor_id integer, p_parqueadero_id integer, p_momento timestamp without time zone DEFAULT CURRENT_TIMESTAMP) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_dia smallint := EXTRACT(ISODOW FROM p_momento)::smallint;
    v_hora time := p_momento::time;
BEGIN
    RETURN EXISTS (
        SELECT 1
        FROM "autorizacion_acceso" a
        WHERE a.estado = true
          AND (a.usuario_id = p_usuario_id OR a.conductor_id = p_conductor_id)
          AND (a.parqueadero_id IS NULL OR a.parqueadero_id = p_parqueadero_id)
          AND (a.dia_semana IS NULL OR a.dia_semana = v_dia)
          AND (a.hora_inicio IS NULL OR a.hora_fin IS NULL OR v_hora BETWEEN a.hora_inicio AND a.hora_fin)
          AND (a.fecha_inicio IS NULL OR p_momento::date >= a.fecha_inicio)
          AND (a.fecha_fin IS NULL OR p_momento::date <= a.fecha_fin)
    );
END;
$$;


--
-- Name: fn_usuario_fecha_modificacion(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_usuario_fecha_modificacion() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    NEW.fecha_modificacion = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$;


--
-- Name: fn_validar_conflicto_reserva(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_validar_conflicto_reserva() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW.estado IN ('PENDIENTE'::estado_reserva_enum, 'ACEPTADA'::estado_reserva_enum) THEN
        IF EXISTS (
            SELECT 1
            FROM "reserva" r
            WHERE r.id <> COALESCE(NEW.id, -1)
              AND r.celda_id = NEW.celda_id
              AND r.estado IN ('PENDIENTE'::estado_reserva_enum, 'ACEPTADA'::estado_reserva_enum)
              AND NEW.fecha_hora_inicio < r.fecha_hora_fin
              AND NEW.fecha_hora_fin > r.fecha_hora_inicio
        ) THEN
            RAISE EXCEPTION 'La celda % ya tiene una reserva que se sobrepone al rango solicitado.', NEW.celda_id;
        END IF;
    END IF;

    RETURN NEW;
END;
$$;


--
-- Name: fn_validar_ocupacion_celda(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_validar_ocupacion_celda() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_estado_celda  estado_celda_enum;
    v_tipo_celda    tipo_vehiculo_enum;
    v_usabilidad    usabilidad_enum;
    v_tipo_vehiculo tipo_vehiculo_enum;
    v_numero        VARCHAR(10);
    v_reservada_por INT;
    v_conductor_id  INT;
    v_apto          BOOLEAN;
    v_nombre        VARCHAR(200);
BEGIN
    SELECT c.estado, c.tipo, c.usabilidad, c.numero
      INTO v_estado_celda, v_tipo_celda, v_usabilidad, v_numero
      FROM celda c WHERE c.id = NEW.celda_id;

    IF v_estado_celda IS NULL THEN
        RAISE EXCEPTION 'La celda % no existe.', NEW.celda_id;
    END IF;

    SELECT v.tipo INTO v_tipo_vehiculo FROM vehiculo v WHERE v.id = NEW.vehiculo_id;
    IF v_tipo_vehiculo IS NULL THEN
        RAISE EXCEPTION 'El vehiculo % no existe.', NEW.vehiculo_id;
    END IF;

    -- 3.1 Celda fuera de servicio
    IF v_estado_celda IN ('MANTENIMIENTO','INACTIVA') THEN
        RAISE EXCEPTION 'La celda % esta en % y no admite ocupacion.',
                        v_numero, v_estado_celda;
    END IF;

    -- 3.2 Celda ya ocupada
    IF EXISTS (SELECT 1 FROM ocupacion_celda oc
               WHERE oc.celda_id = NEW.celda_id AND oc.estado = 'ACTIVA'
                 AND oc.id IS DISTINCT FROM NEW.id) THEN
        RAISE EXCEPTION 'La celda % ya tiene una ocupacion activa.', v_numero;
    END IF;

    -- 3.3 Celda reservada: solo el vehiculo de la reserva
    IF v_estado_celda = 'RESERVADA' THEN
        SELECT r.vehiculo_id INTO v_reservada_por
          FROM reserva r
         WHERE r.celda_id = NEW.celda_id AND r.estado = 'ACEPTADA'
           AND COALESCE(NEW.fecha_hora_inicio, CURRENT_TIMESTAMP)
               BETWEEN r.fecha_hora_inicio AND r.fecha_hora_fin
         ORDER BY r.fecha_hora_inicio LIMIT 1;

        IF v_reservada_por IS NOT NULL
           AND v_reservada_por IS DISTINCT FROM NEW.vehiculo_id THEN
            RAISE EXCEPTION 'La celda % esta reservada para otro vehiculo.', v_numero;
        END IF;
    END IF;

    -- 3.4 Tipo de celda contra tipo de vehiculo
    IF v_tipo_celda <> v_tipo_vehiculo THEN
        RAISE EXCEPTION
          'El tipo de vehiculo (%) no corresponde con el tipo de la celda % (%).',
          v_tipo_vehiculo, v_numero, v_tipo_celda;
    END IF;

    -- 3.5 CELDA PREFERENCIAL: exige condicion de movilidad reducida
    IF v_usabilidad = 'MOVILIDAD_REDUCIDA' THEN
        -- conductor del ingreso; si no viene, el propietario principal
        SELECT ra.conductor_id INTO v_conductor_id
          FROM registro_acceso ra WHERE ra.id = NEW.registro_acceso_id;

        IF v_conductor_id IS NULL THEN
            SELECT dp.conductor_id INTO v_conductor_id
              FROM detalle_propiedad dp
             WHERE dp.vehiculo_id = NEW.vehiculo_id
               AND dp.es_principal = TRUE AND dp.estado = TRUE
             LIMIT 1;
        END IF;

        IF v_conductor_id IS NULL THEN
            RAISE EXCEPTION
              'La celda % es de movilidad reducida: se requiere identificar al conductor.', v_numero;
        END IF;

        SELECT co.movilidad_reducida, co.nombre_apellidos
          INTO v_apto, v_nombre
          FROM conductor co WHERE co.id = v_conductor_id;

        IF NOT COALESCE(v_apto, FALSE) THEN
            RAISE EXCEPTION
              'La celda % es de caracter preferencial y % no tiene registrada condicion de movilidad reducida.',
              v_numero, v_nombre;
        END IF;
    END IF;

    RETURN NEW;
END;
$$;


--
-- Name: fn_validar_reserva_preferencial(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.fn_validar_reserva_preferencial() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_usabilidad   usabilidad_enum;
    v_numero       VARCHAR(10);
    v_conductor_id INT;
    v_apto         BOOLEAN;
    v_nombre       VARCHAR(200);
BEGIN
    SELECT c.usabilidad, c.numero INTO v_usabilidad, v_numero
      FROM celda c WHERE c.id = NEW.celda_id;

    IF v_usabilidad = 'MOVILIDAD_REDUCIDA' OR NEW.tipo_reserva = 'MOVILIDAD_REDUCIDA' THEN

        v_conductor_id := NEW.conductor_id;

        IF v_conductor_id IS NULL AND NEW.vehiculo_id IS NOT NULL THEN
            SELECT dp.conductor_id INTO v_conductor_id
              FROM detalle_propiedad dp
             WHERE dp.vehiculo_id = NEW.vehiculo_id
               AND dp.es_principal = TRUE AND dp.estado = TRUE
             LIMIT 1;
        END IF;

        IF v_conductor_id IS NULL THEN
            RAISE EXCEPTION
              'Una reserva de movilidad reducida debe indicar el conductor beneficiario.';
        END IF;

        SELECT co.movilidad_reducida, co.nombre_apellidos
          INTO v_apto, v_nombre
          FROM conductor co WHERE co.id = v_conductor_id;

        IF NOT COALESCE(v_apto, FALSE) THEN
            RAISE EXCEPTION
              '% no tiene registrada condicion de movilidad reducida: no puede reservar la celda %.',
              v_nombre, COALESCE(v_numero, '(preferencial)');
        END IF;
    END IF;

    RETURN NEW;
END;
$$;


SET default_tablespace = '';

SET default_table_access_method = heap;

--
-- Name: asignacion_vigilante; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.asignacion_vigilante (
    id integer NOT NULL,
    usuario_id integer NOT NULL,
    parqueadero_id integer NOT NULL,
    turno public.turno_enum NOT NULL,
    fecha_inicio date NOT NULL,
    fecha_fin date,
    estado boolean DEFAULT true NOT NULL,
    hora_inicio time without time zone,
    hora_fin time without time zone,
    CONSTRAINT ck_asignacion_vigilante_horas CHECK (((hora_inicio IS NULL) OR (hora_fin IS NULL) OR (hora_fin > hora_inicio)))
);


--
-- Name: TABLE asignacion_vigilante; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.asignacion_vigilante IS 'E-19: tabla nueva. 6 HU hablan de "las zonas asignadas al vigilante" y del turno (03.1.8.2, 03.1.10.2, 05.1.6.3, 06.2.5.1, 06.2.6.1, 06.2.7.3). DECISIÓN PENDIENTE: si todos los vigilantes ven todo, se elimina esta tabla y se ajustan esas 6 HU.';


--
-- Name: asignacion_vigilante_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.asignacion_vigilante ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.asignacion_vigilante_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: auditoria; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.auditoria (
    id bigint NOT NULL,
    tabla_afectada character varying(50) NOT NULL,
    registro_id integer NOT NULL,
    accion public.accion_auditoria_enum NOT NULL,
    usuario_id integer NOT NULL,
    fecha_hora timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    motivo character varying(255),
    valor_anterior jsonb,
    valor_nuevo jsonb
);


--
-- Name: TABLE auditoria; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.auditoria IS 'E-18: tabla nueva. 23 criterios de aceptación exigen registrar "usuario y fecha" del cambio, y varias HU piden un "historial". Ninguna tabla del modelo anterior lo permitía.';


--
-- Name: COLUMN auditoria.motivo; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.auditoria.motivo IS 'HU 03.1.6.2: motivo obligatorio en cada cambio de estado';


--
-- Name: auditoria_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.auditoria ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.auditoria_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: autorizacion_acceso; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.autorizacion_acceso (
    id integer NOT NULL,
    usuario_id integer,
    conductor_id integer,
    parqueadero_id integer,
    dia_semana smallint,
    hora_inicio time without time zone,
    hora_fin time without time zone,
    fecha_inicio date,
    fecha_fin date,
    motivo character varying(255),
    estado boolean DEFAULT true NOT NULL,
    fecha_creacion timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT ck_autorizacion_dia CHECK (((dia_semana IS NULL) OR ((dia_semana >= 1) AND (dia_semana <= 7)))),
    CONSTRAINT ck_autorizacion_fechas CHECK (((fecha_inicio IS NULL) OR (fecha_fin IS NULL) OR (fecha_fin >= fecha_inicio))),
    CONSTRAINT ck_autorizacion_horas CHECK (((hora_inicio IS NULL) OR (hora_fin IS NULL) OR (hora_fin > hora_inicio))),
    CONSTRAINT ck_autorizacion_responsable CHECK (((usuario_id IS NOT NULL) OR (conductor_id IS NOT NULL)))
);


--
-- Name: autorizacion_acceso_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.autorizacion_acceso ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.autorizacion_acceso_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: captura_placa; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.captura_placa (
    id integer NOT NULL,
    placa_detectada character varying(10) NOT NULL,
    imagen_url character varying(500),
    confianza numeric(5,2),
    parqueadero_id integer NOT NULL,
    vehiculo_id integer,
    registro_acceso_id integer,
    verificada boolean DEFAULT false NOT NULL,
    usuario_verifica_id integer,
    fecha_hora timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    placa_normalizada character varying(10),
    motor_ocr character varying(50),
    procesada boolean DEFAULT false NOT NULL,
    fecha_procesamiento timestamp without time zone,
    error_ocr character varying(500),
    direccion_captura character varying(10),
    origen character varying(30) DEFAULT 'NAVEGADOR'::character varying NOT NULL,
    CONSTRAINT ck_captura_placa_confianza CHECK (((confianza IS NULL) OR ((confianza >= (0)::numeric) AND (confianza <= (100)::numeric)))),
    CONSTRAINT ck_captura_placa_direccion CHECK (((direccion_captura IS NULL) OR ((direccion_captura)::text = ANY (ARRAY[('ENTRADA'::character varying)::text, ('SALIDA'::character varying)::text]))))
);


--
-- Name: TABLE captura_placa; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.captura_placa IS 'Proceso 07.2 — Reconocimiento de placa. DECISIÓN PENDIENTE: si el alcance real es sólo digitación manual, se elimina esta tabla y se ajusta la redacción de la ficha.';


--
-- Name: COLUMN captura_placa.confianza; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.captura_placa.confianza IS '% de certeza del reconocimiento';


--
-- Name: COLUMN captura_placa.vehiculo_id; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.captura_placa.vehiculo_id IS 'NULL si la placa no está registrada';


--
-- Name: COLUMN captura_placa.origen; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.captura_placa.origen IS 'De donde vino la lectura: NAVEGADOR (tesseract.js en el cliente), CAMARA_FIJA o MANUAL.';


--
-- Name: captura_placa_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.captura_placa ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.captura_placa_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: celda; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.celda (
    id integer NOT NULL,
    parqueadero_id integer NOT NULL,
    numero character varying(10) NOT NULL,
    tipo public.tipo_vehiculo_enum NOT NULL,
    usabilidad public.usabilidad_enum DEFAULT 'GENERAL'::public.usabilidad_enum NOT NULL,
    estado public.estado_celda_enum DEFAULT 'DISPONIBLE'::public.estado_celda_enum NOT NULL,
    observaciones character varying(255),
    posicion_x numeric(10,2),
    posicion_y numeric(10,2),
    ancho numeric(10,2),
    alto numeric(10,2),
    CONSTRAINT ck_celda_posiciones CHECK ((((posicion_x IS NULL) OR (posicion_x >= (0)::numeric)) AND ((posicion_y IS NULL) OR (posicion_y >= (0)::numeric)) AND ((ancho IS NULL) OR (ancho > (0)::numeric)) AND ((alto IS NULL) OR (alto > (0)::numeric))))
);


--
-- Name: TABLE celda; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.celda IS 'Proceso 03.2 — Gestión de celdas';


--
-- Name: COLUMN celda.numero; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.celda.numero IS 'E-04: faltaba. Las HU la llaman "nombre (numeración de la celda)"';


--
-- Name: COLUMN celda.tipo; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.celda.tipo IS 'E-17: ahora incluye CAMION y BUS. MOVILIDAD_REDUCIDA se movió a usabilidad para no duplicar el concepto';


--
-- Name: COLUMN celda.estado; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON COLUMN public.celda.estado IS 'UNICA fuente de verdad del estado de la celda. La mueven: el ingreso/salida de vehiculos, la aceptacion de reservas y los cambios manuales via disponibilidad_celda. No consultar ocupacion_celda ni disponibilidad_celda para saber si esta libre.';


--
